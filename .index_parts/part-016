  async function hsCreatePdfBlob(software) {
    const templates=software==='PSW'?HS_PSW_TEMPLATE_JPEGS:HS_DPI_TEMPLATE_JPEGS;
    const warnings=[], pages=[];
    for(let i=0;i<templates.length;i++) {
      d4Status(`${software==='PSW'?'HS/CORE PSW':'HS DPInkjet'}-Protokoll wird erstellt … Seite ${i+1}/${templates.length}`);
      const img=await d4LoadImage(templates[i]);
      const canvas=document.createElement('canvas'); canvas.width=D4_IMG_W; canvas.height=D4_IMG_H;
      const ctx=canvas.getContext('2d',{alpha:false}); ctx.drawImage(img,0,0,D4_IMG_W,D4_IMG_H);
      hsOverlayPage(ctx,i+1,software,warnings);
      pages.push(await d4CanvasJpegBytes(canvas)); canvas.width=1; canvas.height=1;
    }
    const pdf=d4BuildPdf(pages);
    return {blob:new Blob([pdf],{type:'application/pdf'}),warnings};
  }

