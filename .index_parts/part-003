    const b = blocks.find(item => item?.id === blockId);
    if (!b?.conditions?.machine) return;
    const machines = String(b.conditions.machine).split(',').map(v => v.trim()).filter(Boolean);
    const remaining = machines.filter(v => !withoutP5X.has(v));
    if (!remaining.length) {
      const idx = blocks.indexOf(b);
