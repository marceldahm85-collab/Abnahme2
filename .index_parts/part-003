const form = document.getElementById('protokoll-form');
const dateField = document.getElementById('protokoll-datum');

function normalizeLegacyProtocolData(source) {
  const data = source && typeof source === 'object' ? { ...source } : {};
  if (!Object.prototype.hasOwnProperty.call(data, 'signoff_testpattern')) {
    const legacy = Array.isArray(data.signoff_gardamatt_matt) ? data.signoff_gardamatt_matt : [];
    const okCount = legacy.filter(value => value === 'ok').length;
    if (okCount > 0) {
      // Die alte Version hatte Testpattern und Gardamatt-Matt mit demselben Namen.
      // Bei einem einzelnen alten Haken entsprach das bisher beim Laden dem ersten Feld (= Testpattern).
      data.signoff_testpattern = ['ok'];
      if (okCount === 1) data.signoff_gardamatt_matt = [];
    }
  }
  return data;
}

function getProtocolSignoffName() {
  const raw = form.querySelector('[name="qm_pruefer"]')?.value || '';
  return raw.replace(/^QM[-\s]*/i, '').trim();
}

function getProtocolAutomationContext() {
  const testpatternOk = !!form.querySelector('[name="signoff_testpattern"][value="ok"]')?.checked;
  const machine = form.querySelector('[name="maschinentyp"]')?.value || '';
  const software = form.querySelector('[name="drucksoftware"]')?.value || '';
  let template = null;
  if (machine === 'P5 SMP') template = 'smp';
  else if (machine === 'P5 D4' || machine === 'P5 D4 - USA') template = 'd4';
  else if (machine === 'P5 X - Flatbed' || machine === 'P5 X - Hybrid') template = 'p5x';
  else if (machine === 'P5 / HS') {
    template = software === 'DPInkjet' ? 'hs-dpinkjet' : software === 'PSW' ? 'hs-psw' : null;
  } else if (machine === 'P5 350 CORE') {
    // In den bereitgestellten Vorlagen ist CORE nur im PSW-Protokoll enthalten.
    template = software === 'PSW' ? 'hs-psw' : null;
  }
  // SMP Monitoring wird bewusst nicht auf ein automatisches Protokoll geroutet.
  return {
    template,
    machine,
    software,
    signoffName: getProtocolSignoffName(),
    testpatternOk,
    mitschickbildOk: testpatternOk,
    archivbildOk: testpatternOk
  };
}

function saveData() {
  const data = {};
  form.querySelectorAll('input, select, textarea').forEach(el => {
    if (el.type === 'checkbox') {
      if (!data[el.name]) data[el.name] = [];
      if (el.checked) data[el.name].push(el.value);
    } else if (el.name) {
      data[el.name] = el.value;
    }
  });
  if (dateField.value) data['protokoll-datum'] = dateField.value;
  localStorage.setItem('abnahmeprotokoll', JSON.stringify(data));
}

function loadData() {
  const rawSaved = JSON.parse(localStorage.getItem('abnahmeprotokoll'));
  if (!rawSaved) return;
  const saved = normalizeLegacyProtocolData(rawSaved);
  Object.entries(saved).forEach(([key, value]) => {
    if (key === 'protokoll-datum') {
      // Das Datumsfeld besitzt bewusst ein eigenes name-Attribut.
      // Dadurch wird es beim Autosave wie jedes andere Formularfeld behandelt
      // und beim Wiederherstellen zuverlässig gesetzt.
      if (dateField) dateField.value = value || '';
      return;
    }
    if (Array.isArray(value)) {
      value.forEach(v => {
        const cb = document.querySelector(`input[type=checkbox][name="${key}"][value="${v}"]`);
        if (cb) cb.checked = true;
      });
    } else {
      const field = document.querySelector(`[name="${key}"]`);
      if (field) field.value = value;
    }
  });
}

// Mehrfachspeicher: alle gespeicherten Sätze unter abnahmeprotokoll_saves
function getSavedEntries() {
  const raw = localStorage.getItem('abnahmeprotokoll_saves');
  if (!raw) return {};
  try {
    return JSON.parse(raw) || {};
  } catch (e) {
    console.error('Fehler beim Parsen von abnahmeprotokoll_saves:', e);
    return {};
  }
}

function setSavedEntries(entries) {
  localStorage.setItem('abnahmeprotokoll_saves', JSON.stringify(entries));
}

// Liste unter dem Laden-Button aktualisieren
function renderSavedEntriesList() {
  const listContainer = document.getElementById('saved-entries-list');
  if (!listContainer) return;

  listContainer.innerHTML = '';
  const entries = getSavedEntries();
  const keys = Object.keys(entries);

  if (keys.length === 0) {
    listContainer.innerHTML = '<div style="color:var(--muted); font-size:13px;">Keine gespeicherten Einträge vorhanden.</div>';
    return;
  }

  keys.forEach(key => {
    const box = document.createElement('div');
    box.style.border = '1px solid var(--border)';
    box.style.borderRadius = '8px';
    box.style.padding = '8px 10px';
    box.style.display = 'flex';
    box.style.flexDirection = 'column';
    box.style.gap = '6px';
    box.style.background = 'rgba(255,255,255,0.02)';

    const label = document.createElement('div');
    label.textContent = key; // Seriennummer
    label.style.fontSize = '14px';
    label.style.fontWeight = '600';

    const btnGroup = document.createElement('div');
    btnGroup.style.display = 'flex';
    btnGroup.style.gap = '8px';
    btnGroup.style.marginTop = '4px';

    const loadBtn = document.createElement('button');
    loadBtn.type = 'button';
    loadBtn.textContent = 'Laden';
    loadBtn.classList.add('btn-blue');
    loadBtn.style.flex = '1 1 0';
    loadBtn.addEventListener('click', () => {
      loadEntryByKey(key);
    });

    const deleteBtn = document.createElement('button');
    deleteBtn.type = 'button';
    deleteBtn.textContent = 'Löschen';
    deleteBtn.classList.add('btn-red');
    deleteBtn.style.flex = '1 1 0';
    deleteBtn.addEventListener('click', () => {
      deleteEntryByKey(key);
    });

    btnGroup.appendChild(loadBtn);
    btnGroup.appendChild(deleteBtn);

    box.appendChild(label);
    box.appendChild(btnGroup);
    listContainer.appendChild(box);
  });
}
// Speichern als eigener Eintrag (Seriennummer als Name)
function saveCurrentAsEntry() {
  const serienField = form.querySelector('[name="seriennummer"]');
  if (!serienField) {
    alert('Seriennummer-Feld wurde nicht gefunden.');
    return;
  }
  const key = serienField.value.trim();
  if (!key) {
    alert('Bitte zuerst eine Seriennummer eintragen, um speichern zu können.');
    return;
  }

  // aktuelle Formdaten sammeln (wie in saveData, aber als separates Objekt)
  const data = {};
  form.querySelectorAll('input, select, textarea').forEach(el => {
    if (el.type === 'checkbox') {
      if (!data[el.name]) data[el.name] = [];
      if (el.checked) data[el.name].push(el.value);
    } else if (el.name) {
      data[el.name] = el.value;
    }
  });
  if (dateField.value) data['protokoll-datum'] = dateField.value;

  const allEntries = getSavedEntries();
  allEntries[key] = data;
  setSavedEntries(allEntries);

  // gleichzeitig aktuellen Auto-Save aktualisieren
  localStorage.setItem('abnahmeprotokoll', JSON.stringify(data));

  renderSavedEntriesList();
  alert('Eintrag unter Seriennummer "' + key + '" gespeichert.');
}

function loadEntryByKey(key) {
  const entries = getSavedEntries();
  const rawData = entries[key];
  if (!rawData) {
    alert('Eintrag "' + key + '" wurde nicht gefunden.');
    return;
  }
  const data = normalizeLegacyProtocolData(rawData);

  // Formular zurücksetzen
  form.reset();
  dateField.value = '';

  // erst alle Checkboxen zurücksetzen
  form.querySelectorAll('input[type=checkbox]').forEach(cb => cb.checked = false);

  // Werte setzen (ähnlich loadData)
  Object.entries(data).forEach(([k, value]) => {
    if (k === 'protokoll-datum') {
      dateField.value = value;
      return;
    }
    if (Array.isArray(value)) {
      value.forEach(v => {
        const cb = document.querySelector(`input[type=checkbox][name="${k}"][value="${v}"]`);
        if (cb) cb.checked = true;
      });
    } else {
      const field = document.querySelector(`[name="${k}"]`);
      if (field) field.value = value;
    }
  });

  // abhängige UIs aktualisieren
  updateWhiteSplitVisibility();
  updateCorrugatedVisibility();
  updateBandingVisibility();

  // aktuellen Auto-Save auf diesen Stand setzen
  localStorage.setItem('abnahmeprotokoll', JSON.stringify(data));

  // Auswahlfenster nach dem Laden schließen und direkt zur Bildbewertung springen.
  const savedWrapper = document.getElementById('saved-entries-wrapper');
  if (savedWrapper) savedWrapper.style.display = 'none';
  if (typeof uxOpenSection === 'function') {
    setTimeout(() => uxOpenSection('bild'), 0);
  } else {
    const bildTitle = document.getElementById('section-bild-toggle');
    const bildContent = document.getElementById('section-bild-content');
    if (bildContent && bildTitle) {
      bildContent.style.display = 'block';
      bildTitle.classList.remove('collapsed');
      setTimeout(() => bildTitle.scrollIntoView({behavior:'smooth', block:'start'}), 0);
    }
  }
}

function deleteEntryByKey(key) {
  const entries = getSavedEntries();
  if (!entries[key]) return;

  if (!confirm('Gespeicherten Eintrag "' + key + '" wirklich löschen?')) return;

  delete entries[key];
  setSavedEntries(entries);
  renderSavedEntriesList();
}

