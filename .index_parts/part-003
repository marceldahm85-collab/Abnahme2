function renderConditionEditor(conditions = {}) {
  const container = document.getElementById('evaluation-editor-conditions');
  if (!container) return;
  container.replaceChildren();

  CONDITION_SPECS.forEach(spec => {
    const group = document.createElement('div');
    group.className = 'editor-condition-group';
    group.dataset.conditionKey = spec.key;
    const title = document.createElement('div');
    title.className = 'editor-condition-title';
    title.textContent = spec.label;
    group.appendChild(title);

    const checks = document.createElement('div');
    checks.className = 'editor-checks';
    const current = conditions[spec.key] || 'all';
    const selected = current === 'all' ? [] : current.split(',').map(s => s.trim());

    const allLabel = document.createElement('label');
    allLabel.className = 'editor-check-item';
    const allInput = document.createElement('input');
    allInput.type = 'checkbox';
    allInput.value = 'all';
    allInput.dataset.conditionAll = 'true';
    allInput.checked = current === 'all' || !current;
    allLabel.append(allInput, document.createTextNode('Alle'));
    checks.appendChild(allLabel);

    spec.options.forEach(value => {
      const label = document.createElement('label');
      label.className = 'editor-check-item';
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.value = value;
      input.checked = selected.includes(value);
      label.append(input, document.createTextNode(spec.labels?.[value] || value));
      checks.appendChild(label);
    });

    checks.addEventListener('change', event => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      const all = checks.querySelector('[data-condition-all="true"]');
      const specifics = [...checks.querySelectorAll('input:not([data-condition-all])')];
      if (target.dataset.conditionAll === 'true' && target.checked) specifics.forEach(input => input.checked = false);
      else if (target.dataset.conditionAll !== undefined && target.checked) all.checked = false;
      else if (target !== all && target.checked) all.checked = false;
      if (!all.checked && !specifics.some(input => input.checked)) all.checked = true;
    });

    group.appendChild(checks);
    container.appendChild(group);
  });
}

function serializeConditionEditor() {
  const result = {};
  document.querySelectorAll('#evaluation-editor-conditions .editor-condition-group').forEach(group => {
    const key = group.dataset.conditionKey;
    const all = group.querySelector('[data-condition-all="true"]');
    const selected = [...group.querySelectorAll('input:not([data-condition-all]):checked')].map(input => input.value);
    result[key] = all?.checked || selected.length === 0 ? 'all' : selected.join(', ');
  });
  return result;
}

function fieldTypeLabel(type) {
  return ({rating:'Bewertung',textarea:'Bemerkung',signoff:'Sign-off',numberGrid:'Zahlenraster'})[type] || type;
}

function renderEditorFieldCard(field) {
  const card = document.createElement('div');
  card.className = 'editor-field-card';
  card.dataset.fieldType = field.type;
  if (field.name) card.dataset.fieldName = field.name;
  if (field.id) card.dataset.fieldId = field.id;
  if (field.value) card.dataset.fieldValue = field.value;

  const head = document.createElement('div');
  head.className = 'editor-field-head';
  const type = document.createElement('div');
  type.className = 'editor-field-type';
  type.textContent = fieldTypeLabel(field.type);
  const actions = document.createElement('div');
  actions.className = 'editor-field-actions';
  [['field-up','↑'],['field-down','↓'],['field-delete','Löschen']].forEach(([action,text]) => {
    const btn = document.createElement('button'); btn.type='button'; btn.dataset.editorFieldAction=action; btn.textContent=text; actions.appendChild(btn);
  });
  head.append(type, actions);
  card.appendChild(head);

  if (field.type !== 'numberGrid') {
    const label = document.createElement('label');
    label.textContent = 'Beschriftung';
    const input = document.createElement('input');
    input.type = 'text'; input.className = 'editor-field-label'; input.value = field.label || '';
    card.append(label, input);
  }

  if (field.type === 'rating' || field.type === 'signoff') {
    const label = document.createElement('label'); label.textContent = 'Darstellung';
    const select = document.createElement('select'); select.className = 'editor-field-layout';
    const opts = field.type === 'rating'
      ? [['standard','Standard'],['row','Zeile / Farbbeschriftung']]
      : [['row','Zeile'],['inline','Inline']];
    opts.forEach(([value,text]) => { const o=document.createElement('option'); o.value=value; o.textContent=text; select.appendChild(o); });
    select.value = field.layout || opts[0][0];
    card.append(label, select);
  }

  if (field.type === 'textarea') {
    const label = document.createElement('label'); label.textContent = 'Platzhalter (optional)';
    const input = document.createElement('input'); input.type='text'; input.className='editor-field-placeholder'; input.value=field.placeholder || '';
    card.append(label,input);
  }

  if (field.type === 'numberGrid') {
    const list = document.createElement('div');
    list.className = 'editor-number-subfields';
    (field.fields || []).forEach(item => list.appendChild(renderNumberSubfield(item)));
    card.appendChild(list);
    const add = document.createElement('button'); add.type='button'; add.className='editor-add-number'; add.dataset.editorFieldAction='number-add'; add.textContent='+ Zahlenfeld';
    card.appendChild(add);
  }

  return card;
}

function renderNumberSubfield(item) {
  const row = document.createElement('div');
  row.className = 'editor-number-row';
  row.dataset.fieldName = item.name || '';
  row.dataset.fieldId = item.id || item.name || '';
  const input = document.createElement('input');
  input.type='text'; input.value=item.label || ''; input.placeholder='Beschriftung'; input.className='editor-number-label';
  const del = document.createElement('button'); del.type='button'; del.dataset.editorFieldAction='number-delete'; del.textContent='×'; del.title='Zahlenfeld löschen';
  row.append(input, del);
  return row;
}

function renderEditorFields(fields) {
  const container = document.getElementById('evaluation-editor-fields');
  if (!container) return;
  container.replaceChildren();
  (fields || []).forEach(field => container.appendChild(renderEditorFieldCard(field)));
}

function serializeEditorFields(blockId) {
  const result = [];
  document.querySelectorAll('#evaluation-editor-fields .editor-field-card').forEach(card => {
    const type = card.dataset.fieldType;
    if (type === 'numberGrid') {
      const fields = [...card.querySelectorAll('.editor-number-row')].map(row => {
        const name = row.dataset.fieldName || technicalName(blockId, 'number');
        return { label: row.querySelector('.editor-number-label')?.value.trim() || 'Wert', name, id: row.dataset.fieldId || name, type:'number', step:'0.01', inputmode:'decimal' };
      });
      result.push({type:'numberGrid', fields});
      return;
    }
    const name = card.dataset.fieldName || technicalName(blockId, type || 'field');
    const label = card.querySelector('.editor-field-label')?.value.trim() || '';
    if (type === 'rating') result.push({type, layout:card.querySelector('.editor-field-layout')?.value || 'standard', label, name});
    else if (type === 'textarea') {
      const value = {type, label, name};
      const placeholder = card.querySelector('.editor-field-placeholder')?.value.trim();
      if (placeholder) value.placeholder = placeholder;
      result.push(value);
    } else if (type === 'signoff') result.push({type, layout:card.querySelector('.editor-field-layout')?.value || 'row', label, name, value:card.dataset.fieldValue || 'ok', id:card.dataset.fieldId || generateId('signoff')});
  });
  return result;
}

async function openBlockEditor(blockId = null) {
  const modal = document.getElementById('evaluation-editor-modal');
  if (!modal) return;
  pendingEditorImageFile = null;
  if (pendingEditorPreviewUrl) { URL.revokeObjectURL(pendingEditorPreviewUrl); pendingEditorPreviewUrl = null; }
  document.getElementById('evaluation-editor-image-upload').value = '';
  showEditorStatus('');

  const existing = blockId ? IMAGE_EVALUATION_BLOCKS.find(block => block.id === blockId) : null;
  editorDraftBlock = existing
    ? cloneEvaluationData(existing)
    : { id:generateId('block-user'), title:'Neues Bewertungsbild', image:'', conditions:{machine:'all',software:'all',white:'all',special:'all',corrugated:'all',split:'all',haptprint:'all',liquid:'all'}, fields:[] };
  if (!existing) editorDraftBlock.fields = [createNewField('rating', editorDraftBlock.id), createNewField('textarea', editorDraftBlock.id)];

  document.getElementById('evaluation-editor-title').textContent = existing ? 'Bewertungsbild bearbeiten' : 'Bewertungsbild hinzufügen';
  document.getElementById('evaluation-editor-block-title').value = editorDraftBlock.title || '';
  await populateEditorImageSelect(editorDraftBlock.image || '');
  await updateEditorImagePreview(editorDraftBlock.image || '');
  renderConditionEditor(editorDraftBlock.conditions || {});
  renderEditorFields(editorDraftBlock.fields || []);

  modal.classList.add('open');
  modal.setAttribute('aria-hidden','false');
  document.body.classList.add('evaluation-editor-open');
  document.getElementById('evaluation-editor-block-title').focus();
}

function closeBlockEditor() {
  const modal = document.getElementById('evaluation-editor-modal');
  if (!modal) return;
  modal.classList.remove('open');
  modal.setAttribute('aria-hidden','true');
  document.body.classList.remove('evaluation-editor-open');
  editorDraftBlock = null;
  pendingEditorImageFile = null;
  if (pendingEditorPreviewUrl) { URL.revokeObjectURL(pendingEditorPreviewUrl); pendingEditorPreviewUrl = null; }
}

async function saveBlockEditor() {
  if (!editorDraftBlock) return;
  const title = document.getElementById('evaluation-editor-block-title').value.trim();
  if (!title) { showEditorStatus('Bitte einen Titel eingeben.', true); return; }

  let imageId = document.getElementById('evaluation-editor-image-select').value || '';
  if (pendingEditorImageFile) {
    imageId = generateId('custom-img');
    await idbPut('images', { id:imageId, name:pendingEditorImageFile.name || title, type:pendingEditorImageFile.type || 'image/*', blob:pendingEditorImageFile, createdAt:new Date().toISOString() });
  }

  const updated = {
    id: editorDraftBlock.id,
    title,
    image: imageId,
    conditions: serializeConditionEditor(),
    fields: serializeEditorFields(editorDraftBlock.id)
  };

  const index = IMAGE_EVALUATION_BLOCKS.findIndex(block => block.id === updated.id);
  if (index >= 0) IMAGE_EVALUATION_BLOCKS[index] = updated;
  else IMAGE_EVALUATION_BLOCKS.push(updated);

  try {
    await saveEvaluationConfiguration();
    rerenderEvaluationBlocksPreservingValues();
    saveData();
    closeBlockEditor();
  } catch (error) {
    console.error(error);
    showEditorStatus('Speichern fehlgeschlagen: ' + error.message, true);
  }
}

async function duplicateEvaluationBlock(blockId) {
  const index = IMAGE_EVALUATION_BLOCKS.findIndex(block => block.id === blockId);
  if (index < 0) return;
  const copy = cloneEvaluationData(IMAGE_EVALUATION_BLOCKS[index]);
  copy.id = generateId('block-user');
  copy.title = copy.title + ' – Kopie';
  regenerateBlockFieldIds(copy);
  IMAGE_EVALUATION_BLOCKS.splice(index + 1, 0, copy);
  await saveEvaluationConfiguration();
  rerenderEvaluationBlocksPreservingValues();
}

async function deleteEvaluationBlock(blockId) {
  const block = IMAGE_EVALUATION_BLOCKS.find(item => item.id === blockId);
  if (!block) return;
  if (!confirm('Bewertungsbild „' + block.title + '“ wirklich löschen? Bereits gespeicherte Abnahmen werden nicht verändert.')) return;
  IMAGE_EVALUATION_BLOCKS = IMAGE_EVALUATION_BLOCKS.filter(item => item.id !== blockId);
  await saveEvaluationConfiguration();
  rerenderEvaluationBlocksPreservingValues();
}

async function moveEvaluationBlock(blockId, direction) {
  const index = IMAGE_EVALUATION_BLOCKS.findIndex(block => block.id === blockId);
  const target = index + direction;
  if (index < 0 || target < 0 || target >= IMAGE_EVALUATION_BLOCKS.length) return;
  [IMAGE_EVALUATION_BLOCKS[index], IMAGE_EVALUATION_BLOCKS[target]] = [IMAGE_EVALUATION_BLOCKS[target], IMAGE_EVALUATION_BLOCKS[index]];
  await saveEvaluationConfiguration();
  rerenderEvaluationBlocksPreservingValues();
}

function blobToDataUrl(blob) {
  return new Promise((resolve,reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = () => reject(reader.error);
    reader.readAsDataURL(blob);
  });
}

function dataUrlToBlob(dataUrl) {
  const [meta, data] = String(dataUrl).split(',');
  const mime = /data:([^;]+)/.exec(meta)?.[1] || 'application/octet-stream';
  const binary = atob(data);
  const bytes = new Uint8Array(binary.length);  for (let i=0;i<binary.length;i++) bytes[i] = binary.charCodeAt(i);
  return new Blob([bytes], {type:mime});
}

async function exportEvaluationConfiguration() {
  const images = await idbGetAll('images');
  const customImages = [];
  for (const record of images) customImages.push({id:record.id,name:record.name,type:record.type,dataUrl:await blobToDataUrl(record.blob)});
  const payload = { schema:'abnahmeprotokoll-bildbewertung', version:1, exportedAt:new Date().toISOString(), blocks:cloneEvaluationData(IMAGE_EVALUATION_BLOCKS), customImages };
  const blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'bildbewertung-konfiguration.json';
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

async function importEvaluationConfiguration(file) {
  const text = await file.text();
  const payload = JSON.parse(text);
  if (payload?.schema !== 'abnahmeprotokoll-bildbewertung' || !Array.isArray(payload.blocks)) throw new Error('Die Datei ist keine gültige Bildbewertungs-Konfiguration.');
  if (!confirm('Aktuelle Bearbeitungskonfiguration durch den Import ersetzen? Gespeicherte Abnahmen bleiben erhalten.')) return;

  await idbClear('images');
  customImageUrlCache.forEach(url => URL.revokeObjectURL(url));
  customImageUrlCache.clear();
  for (const image of (payload.customImages || [])) {
    if (!image.id || !image.dataUrl) continue;
    await idbPut('images', {id:image.id,name:image.name || image.id,type:image.type || 'image/*',blob:dataUrlToBlob(image.dataUrl),createdAt:new Date().toISOString()});
  }
  IMAGE_EVALUATION_BLOCKS = cloneEvaluationData(payload.blocks);
  normalizeProtocolFieldIds(IMAGE_EVALUATION_BLOCKS);
  IMAGE_EVALUATION_BLOCKS = migrateCurrentProtocolRules(IMAGE_EVALUATION_BLOCKS);
  await saveEvaluationConfiguration();
  rerenderEvaluationBlocksPreservingValues();
}

async function restoreDefaultEvaluationConfiguration() {
  if (!confirm('Alle eigenen Änderungen an der Bildbewertung und alle selbst hochgeladenen Referenzbilder verwerfen? Gespeicherte Abnahmen bleiben erhalten.')) return;
  IMAGE_EVALUATION_BLOCKS = cloneEvaluationData(DEFAULT_IMAGE_EVALUATION_BLOCKS);
  normalizeProtocolFieldIds(IMAGE_EVALUATION_BLOCKS);
  IMAGE_EVALUATION_BLOCKS = migrateCurrentProtocolRules(IMAGE_EVALUATION_BLOCKS);
  await idbDelete('settings','blocks');
  await idbClear('images');
  customImageUrlCache.forEach(url => URL.revokeObjectURL(url));
  customImageUrlCache.clear();
  rerenderEvaluationBlocksPreservingValues();
}

function setupEvaluationEditor() {
  const toggle = document.getElementById('evaluation-editor-toggle');
  const actions = document.getElementById('evaluation-editor-actions');
  const list = document.getElementById('bildbewertung-list');
  const modal = document.getElementById('evaluation-editor-modal');
  if (!toggle || !actions || !list || !modal) return;

  toggle.addEventListener('click', () => {
    evaluationEditMode = !evaluationEditMode;
    document.body.classList.toggle('evaluation-edit-mode', evaluationEditMode);
    actions.hidden = !evaluationEditMode;
    toggle.textContent = evaluationEditMode ? 'Bearbeitungsmodus beenden' : 'Bearbeitungsmodus';
    updateBandingVisibility();
  });

  document.getElementById('evaluation-add-block')?.addEventListener('click', () => openBlockEditor());
  document.getElementById('evaluation-export-config')?.addEventListener('click', () => exportEvaluationConfiguration().catch(error => alert('Export fehlgeschlagen: ' + error.message)));
  document.getElementById('evaluation-import-config')?.addEventListener('click', () => document.getElementById('evaluation-import-file')?.click());
  document.getElementById('evaluation-restore-default')?.addEventListener('click', () => restoreDefaultEvaluationConfiguration().catch(error => alert('Wiederherstellen fehlgeschlagen: ' + error.message)));

  document.getElementById('evaluation-import-file')?.addEventListener('change', async event => {
    const file = event.target.files?.[0];
    if (!file) return;
    try { await importEvaluationConfiguration(file); }
    catch (error) { alert('Import fehlgeschlagen: ' + error.message); }
    event.target.value = '';
  });

  list.addEventListener('click', async event => {
    const button = event.target.closest('[data-block-action]');
    if (!button || !evaluationEditMode) return;
    const box = button.closest('.banding-box');
    const id = box?.dataset.blockId;
    if (!id) return;
    const action = button.dataset.blockAction;
    try {
      if (action === 'edit') await openBlockEditor(id);
      else if (action === 'duplicate') await duplicateEvaluationBlock(id);
      else if (action === 'delete') await deleteEvaluationBlock(id);
      else if (action === 'up') await moveEvaluationBlock(id, -1);
      else if (action === 'down') await moveEvaluationBlock(id, 1);
    } catch (error) { alert('Änderung fehlgeschlagen: ' + error.message); }
  });

  modal.querySelector('.evaluation-editor-close')?.addEventListener('click', closeBlockEditor);
  document.getElementById('evaluation-editor-cancel')?.addEventListener('click', closeBlockEditor);
  document.getElementById('evaluation-editor-save')?.addEventListener('click', () => saveBlockEditor().catch(error => showEditorStatus(error.message, true)));
  modal.addEventListener('click', event => { if (event.target === modal) closeBlockEditor(); });

  document.getElementById('evaluation-editor-image-select')?.addEventListener('change', event => {
    pendingEditorImageFile = null;
    const upload = document.getElementById('evaluation-editor-image-upload');
    if (upload) upload.value = '';
    updateEditorImagePreview(event.target.value);
  });

  document.getElementById('evaluation-editor-image-upload')?.addEventListener('change', event => {
    const file = event.target.files?.[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) { showEditorStatus('Bitte eine Bilddatei auswählen.', true); return; }
    pendingEditorImageFile = file;
    if (pendingEditorPreviewUrl) URL.revokeObjectURL(pendingEditorPreviewUrl);
    pendingEditorPreviewUrl = URL.createObjectURL(file);
    const preview = document.getElementById('evaluation-editor-image-preview');
    preview.src = pendingEditorPreviewUrl;
    preview.hidden = false;
    showEditorStatus('Neues Bild ausgewählt. Es wird beim Speichern lokal übernommen.');
  });

  modal.querySelector('.editor-fields-toolbar')?.addEventListener('click', event => {
    const button = event.target.closest('[data-add-field]');
    if (!button || !editorDraftBlock) return;
    const field = createNewField(button.dataset.addField, editorDraftBlock.id);
    if (field) document.getElementById('evaluation-editor-fields')?.appendChild(renderEditorFieldCard(field));
  });

  document.getElementById('evaluation-editor-fields')?.addEventListener('click', event => {
    const button = event.target.closest('[data-editor-field-action]');
    if (!button || !editorDraftBlock) return;
    const action = button.dataset.editorFieldAction;
    const card = button.closest('.editor-field-card');
    if (action === 'field-delete') card?.remove();
    else if (action === 'field-up' && card?.previousElementSibling) card.parentElement.insertBefore(card, card.previousElementSibling);
    else if (action === 'field-down' && card?.nextElementSibling) card.parentElement.insertBefore(card.nextElementSibling, card);
    else if (action === 'number-add' && card) card.querySelector('.editor-number-subfields')?.appendChild(renderNumberSubfield(createNewNumberField(editorDraftBlock.id)));
    else if (action === 'number-delete') button.closest('.editor-number-row')?.remove();
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && modal.classList.contains('open')) closeBlockEditor();
  });
}

