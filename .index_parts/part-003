    if (caption.querySelector(".rating-color-dot")) return;

    const dot = document.createElement("span");
    dot.className = "rating-color-dot";

    dot.style.display = "inline-block";
    dot.style.width = "16px";
    dot.style.height = "16px";
    dot.style.minWidth = "16px";
    dot.style.borderRadius = "50%";
    dot.style.backgroundColor = config.color;
    dot.style.border = "1px solid " + config.border;
    dot.style.marginRight = "7px";
    dot.style.verticalAlign = "middle";
    dot.style.boxSizing = "border-box";

    if (config.title) {
      dot.title = config.title;
    }

    caption.style.display = "inline-flex";
    caption.style.alignItems = "center";

    caption.prepend(dot);
  });
});

document.addEventListener("DOMContentLoaded", function () {
    const themeToggle = document.getElementById("theme-toggle");

    if (!themeToggle) return;

    const savedTheme = localStorage.getItem("theme");

    if (savedTheme === "light") {
        document.body.classList.add("light-theme");
