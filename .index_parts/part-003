function createEvaluationLabel(text, htmlFor) {
  const label = document.createElement('label');
  label.textContent = text || '';
  if (htmlFor) label.htmlFor = htmlFor;
  return label;
}

function createRatingPlaceholder(field) {
  const group = document.createElement('div');
  group.className = 'rating-group';
  group.dataset.ratingName = field.name;
  if (Array.isArray(field.values) && field.values.length) {
    group.dataset.ratingValues = field.values.map(String).join(',');
  }

  if (field.layout === 'row') {
    const row = document.createElement('div');
    row.className = 'rating-row';
    const caption = document.createElement('div');
    caption.className = 'rating-caption';
    caption.textContent = field.label || '';
    row.appendChild(caption);
    row.appendChild(group);
    return row;
  }

  const fragment = document.createDocumentFragment();
  fragment.appendChild(createEvaluationLabel(field.label));
  fragment.appendChild(group);
  return fragment;
}

function createSignoffField(field) {
  const input = document.createElement('input');
  input.type = 'checkbox';
  input.name = field.name;
  input.value = field.value || 'ok';
  input.className = 'signoff-input';
  if (field.id) input.id = field.id;

  const check = document.createElement('span');
  check.className = 'signoff-check';

  const control = document.createElement('label');
  control.appendChild(input);
  control.appendChild(check);

  const caption = document.createElement('span');
  caption.className = 'signoff-label';
  caption.textContent = field.label || '';

  if (field.layout === 'row') {
    const row = document.createElement('div');
    row.className = 'signoff-row';
    row.appendChild(caption);
    row.appendChild(control);
    return row;
  }

  const fragment = document.createDocumentFragment();
  fragment.appendChild(caption);
  fragment.appendChild(control);
  return fragment;
}

function createTextareaField(field) {
  const fragment = document.createDocumentFragment();
  fragment.appendChild(createEvaluationLabel(field.label));
  const textarea = document.createElement('textarea');
  textarea.name = field.name;
  if (field.id) textarea.id = field.id;
  if (field.placeholder) textarea.placeholder = field.placeholder;
  if (field.rows) textarea.rows = field.rows;
  fragment.appendChild(textarea);
  return fragment;
}

function createNumberGrid(field) {
  const grid = document.createElement('div');
  grid.className = 'number-grid';
  (field.fields || []).forEach(item => {
    const wrapper = document.createElement('div');
    const input = document.createElement('input');
    input.type = item.type || 'number';
    input.name = item.name;
    const id = item.id || item.name;
    if (id) input.id = id;
    ['step', 'inputmode', 'min', 'max', 'placeholder'].forEach(attr => {
      if (item[attr] !== undefined && item[attr] !== null) input.setAttribute(attr, item[attr]);
    });
    wrapper.appendChild(createEvaluationLabel(item.label, id));
    wrapper.appendChild(input);
    grid.appendChild(wrapper);
  });
  return grid;
}

function renderEvaluationBlocks() {
  const list = document.getElementById('bildbewertung-list');
  if (!list) return;
  list.replaceChildren();

  IMAGE_EVALUATION_BLOCKS.forEach(block => {
    const box = document.createElement('div');
    box.className = 'banding-box';
    box.dataset.blockId = block.id;
    Object.entries(block.conditions || {}).forEach(([key, value]) => {
      if (value !== undefined && value !== null && value !== '') box.dataset[key] = value;
    });

    const header = document.createElement('div');
    header.className = 'banding-box-header';

    const title = document.createElement('div');
    title.className = 'banding-box-title';
    title.textContent = block.title;
    header.appendChild(title);

    if (block.image) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'reference-image-btn';
      button.dataset.referenceImage = block.image;
      button.title = 'Referenzbild öffnen';
      button.setAttribute('aria-label', 'Referenzbild öffnen: ' + block.title);
      const icon = document.createElement('span');
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = '🖼';
      const text = document.createElement('span');
      text.textContent = 'Referenz';
      button.append(icon, text);
      header.appendChild(button);
    }

    const editorActions = document.createElement('div');
    editorActions.className = 'evaluation-block-actions';
    editorActions.append(
      createBlockActionButton('up', '↑', 'Nach oben verschieben'),
      createBlockActionButton('down', '↓', 'Nach unten verschieben'),
      createBlockActionButton('edit', '✎', 'Bearbeiten'),
      createBlockActionButton('duplicate', '⧉', 'Duplizieren'),
      createBlockActionButton('delete', '×', 'Löschen')
    );
    header.appendChild(editorActions);

    box.appendChild(header);

    (block.fields || []).forEach(field => {
      let element = null;
      if (field.type === 'rating') element = createRatingPlaceholder(field);
      else if (field.type === 'textarea') element = createTextareaField(field);
      else if (field.type === 'signoff') element = createSignoffField(field);
      else if (field.type === 'numberGrid') element = createNumberGrid(field);
      if (element) box.appendChild(element);
    });

    list.appendChild(box);
  });
}

function renderRatingGroups() {
  document.querySelectorAll('.rating-group[data-rating-name]').forEach(group => {
    const name = group.dataset.ratingName;
    if (!name || group.dataset.ratingReady === 'true') return;

    const allowedValues = group.dataset.ratingValues
      ? new Set(group.dataset.ratingValues.split(',').map(v => v.trim()).filter(Boolean))
      : null;
    RATING_SCALE.filter(item => !allowedValues || allowedValues.has(String(item.value))).forEach(item => {
      const id = 'rating-' + name.replace(/[^a-zA-Z0-9_-]/g, '-') + '-' + item.value;
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.id = id;
      input.name = name;
      input.value = item.value;
      input.className = 'rating-' + item.value;

      const label = document.createElement('label');
      label.htmlFor = id;
      label.textContent = item.label;
      label.style.setProperty('--rating-color', item.color);

      group.appendChild(input);
      group.appendChild(label);
    });

    group.dataset.ratingReady = 'true';
  });
}

function setupReferenceImageModal() {
  const modal = document.getElementById('reference-image-modal');
  const modalImg = document.getElementById('reference-image-modal-img');
  const modalTitle = document.getElementById('reference-image-modal-title');
  const closeBtn = modal ? modal.querySelector('.reference-image-close') : null;
  const bildBereich = document.getElementById('section-bild-content');
  if (!modal || !modalImg || !modalTitle || !closeBtn || !bildBereich) return;

  const closeModal = () => {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    modalImg.removeAttribute('src');
    modalImg.alt = '';
    document.body.classList.remove('reference-image-open');
  };

  bildBereich.addEventListener('click', async event => {
    const button = event.target.closest('.reference-image-btn');
    if (!button) return;

    const src = await getReferenceImageSource(button.dataset.referenceImage);
    if (!src) return;

    const box = button.closest('.banding-box');
    const title = box?.querySelector('.banding-box-title')?.textContent?.trim() || 'Referenzbild';
    modalTitle.textContent = title;
    modalImg.src = src;
    modalImg.alt = 'Referenzbild: ' + title;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('reference-image-open');
    closeBtn.focus();
  });

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', event => {
    if (event.target === modal) closeModal();
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && modal.classList.contains('open')) closeModal();
  });
}


function applyCurrentAslRule() {
  const machine = document.querySelector('[name="maschinentyp"]')?.value || '';
  const rdp = document.querySelector('[name="rdp"]');
  if (!rdp) return;

  const isD4 = machine === 'P5 D4' || machine === 'P5 D4 - USA';
  const isHsCurrent = machine === 'P5 / HS' || machine === 'P5 350 CORE';
  const isP5x = machine === 'P5 X - Flatbed' || machine === 'P5 X - Hybrid';
  const isSmp = machine === 'P5 SMP';
  if (isD4 || isHsCurrent || isP5x) {
    rdp.value = 'Level 2';
    rdp.disabled = true;
    rdp.dataset.protocolForced = 'true';
    rdp.title = isD4
      ? 'P5 D4: alle Abnahmebilder mit ASL/RDP 2; Sign-Off-Bilder mit ASL 1.'
      : isP5x
        ? 'P5-X Rev. 6E: ASL 2 als Default für alle Drucke.'
        : 'Aktuelles HS/CORE-Protokoll: alle Abnahmebilder mit ASL/RDP 2.';
  } else if (isSmp) {
    rdp.value = 'Ohne';
    rdp.disabled = true;
    rdp.dataset.protocolForced = 'true';
    rdp.title = 'P5 SMP: laut aktuellem 1E-Protokoll kein ASL aktivieren.';
  } else if (rdp.dataset.protocolForced === 'true') {
    rdp.disabled = false;
    delete rdp.dataset.protocolForced;
    rdp.removeAttribute('title');
  }
}

function updateBandingVisibility() {
  applyCurrentAslRule();
  const machineSelect = document.querySelector('[name="maschinentyp"]');
  const whiteSelect = document.querySelector('[name="white_varnish"]');
  const specialSelect = document.querySelector('[name="Sonderfarben"]');
  const corrSelect = document.querySelector('[name="corrugated"]');
  const splitSelect = document.querySelector('[name="white_split"]');
  const haptSelect = document.querySelector('[name="haptprint"]');
  const liquidSelect = document.querySelector('[name="liquidlamination"]');
  const softwareSelect = document.querySelector('[name="drucksoftware"]');
  const primerSelect = document.querySelector('[name="primer"]');
  const primerWrapper = document.getElementById('primer-wrapper');

  const machine = machineSelect ? machineSelect.value : '';
  const white = whiteSelect ? whiteSelect.value : '';
  const special = specialSelect ? specialSelect.value : '';
  const corr = corrSelect ? corrSelect.value : '';
  const split = splitSelect ? splitSelect.value : '';
  const hapt = haptSelect ? haptSelect.value : '';
  const liquid = liquidSelect ? liquidSelect.value : '';
  const software = softwareSelect ? softwareSelect.value : '';
  const primer = primerSelect ? primerSelect.value : '';

  if (primerWrapper) primerWrapper.style.display = (machine === 'P5 X - Flatbed' || machine === 'P5 X - Hybrid') ? 'block' : 'none';

  document.querySelectorAll('.banding-box').forEach(box => {
    let show = true;

    // MACHINE – auch im Bearbeitungsmodus immer auf die aktuell ausgewählte
    // Maschine begrenzen. Im Bearbeitungsmodus werden lediglich die weiteren
    // Optionsfilter (White/Sonderfarben/etc.) bewusst nicht eingeschränkt, damit
    // alle Bewertungsbilder dieser Maschine bearbeitbar bleiben.
    if (box.dataset.machine && box.dataset.machine !== 'all') {
      const allowedMachines = box.dataset.machine.split(',').map(s => s.trim());
      if (!allowedMachines.includes(machine)) show = false;
    }

    if (!show) {
      box.style.display = 'none';
      return;
    }

    if (evaluationEditMode) {
      box.style.display = 'block';
      return;
    }

    // DRUCKSOFTWARE - nur fuer HS/CORE relevant. Andere Maschinentypen
    // behalten ihre bisherige Filterlogik, auch wenn das Feld global befuellt ist.
    if ((machine === 'P5 / HS' || machine === 'P5 350 CORE') && box.dataset.software && box.dataset.software !== 'all') {
      const allowedSoftware = box.dataset.software.split(',').map(s => s.trim());
      if (!software || !allowedSoftware.includes(software)) show = false;
    }

    // WHITE
    if (box.dataset.white && box.dataset.white !== 'all') {
      const allowedWhite = box.dataset.white.split(',').map(s => s.trim());
      if (!allowedWhite.includes(white)) show = false;
    }

    // SPECIAL (inkl. any-filled)
    if (box.dataset.special && box.dataset.special !== 'all') {
      if (box.dataset.special === 'any-filled') {
        if (!special || special === 'nicht gefüllt') show = false;
      } else {
        const allowedSpecial = box.dataset.special.split(',').map(s => s.trim());
        if (!allowedSpecial.includes(special)) show = false;
      }
    }

    // CORRUGATED
    if (box.dataset.corrugated && box.dataset.corrugated !== 'all') {
      const allowedCorr = box.dataset.corrugated.split(',').map(s => s.trim());
      if (!allowedCorr.includes(corr)) show = false;
    }

    // WHITE-SPLIT (Aufteilung)
    if (box.dataset.split && box.dataset.split !== 'all') {
      // Wenn eine Aufteilung verlangt wird, aber noch nichts gewählt ist: nicht anzeigen
      if (!split) {
        show = false;
      } else {
        const allowedSplits = box.dataset.split.split(',').map(s => s.trim());
        if (!allowedSplits.includes(split)) show = false;
      }
    }

    // HAPTPrint
    if (box.dataset.haptprint && box.dataset.haptprint !== 'all') {
      if (!hapt) {
        show = false;
      } else {
        const allowedHapt = box.dataset.haptprint.split(',').map(s => s.trim());
        if (!allowedHapt.includes(hapt)) show = false;
      }
    }

    // LiquidLamination
    if (box.dataset.liquid && box.dataset.liquid !== 'all') {
      if (!liquid) {
        show = false;
      } else {
        const allowedLiquid = box.dataset.liquid.split(',').map(s => s.trim());
        if (!allowedLiquid.includes(liquid)) show = false;
      }
    }

    // PRIMER - nur P5-X
    if (box.dataset.primer && box.dataset.primer !== 'all') {
      const allowedPrimer = box.dataset.primer.split(',').map(s => s.trim());
      if (!primer || !allowedPrimer.includes(primer)) show = false;
    }

    box.style.display = show ? 'block' : 'none';
  });
}

