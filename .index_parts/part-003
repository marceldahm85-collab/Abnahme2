// ── Mobile UX refinement layer ────────────────────────────────────────────
(function () {
  const $ = (sel, root=document) => root.querySelector(sel);
  const $$ = (sel, root=document) => [...root.querySelectorAll(sel)];

  function uxOpenSection(key, smooth=true) {
    const map = {
      allgemein:['section-allgemein-toggle','section-allgemein-content'],
      spez:['section-spez-toggle','section-spez-content'],
      bild:['section-bild-toggle','section-bild-content']
    };
    const pair = map[key];
    if (!pair) return;
    const title = document.getElementById(pair[0]);
    const content = document.getElementById(pair[1]);
    if (!title || !content) return;
    if (content.style.display === 'none') {
      content.style.display = 'block';
      title.classList.remove('collapsed');
    }
    requestAnimationFrame(() => title.scrollIntoView({behavior:smooth?'smooth':'auto', block:'start'}));
  }

  function uxDecorateSectionTitles() {
    const defs = [
      ['section-allgemein-toggle','1','Allgemein','allgemein'],
      ['section-spez-toggle','2','Spezifikationen','spez'],
      ['section-bild-toggle','3','Bildbenotung','bild']
    ];
    defs.forEach(([id,n,label,key]) => {
      const title=document.getElementById(id);
      if (!title || title.dataset.uxReady) return;
      title.dataset.uxReady='1';
      title.dataset.uxKey=key;
      title.textContent='';
      const main=document.createElement('span');
      main.className='ux-section-main';
      main.innerHTML='<span class="ux-step-number">'+n+'</span><span>'+label+'</span>';
      const summary=document.createElement('span');
      summary.className='ux-section-summary';
      title.append(main,summary);
    });
  }

  function uxCompactStaticSections() {
    ['section-allgemein-content','section-spez-content'].forEach(id => {
      const section=document.getElementById(id);
      if (!section || section.dataset.uxCompact) return;
      section.dataset.uxCompact='1';
      const labels=$$('label',section).filter(l => l.parentElement===section);
      labels.forEach(label => {
        const control=label.nextElementSibling;
        if (!control || !/^(INPUT|SELECT|TEXTAREA)$/.test(control.tagName)) return;
        const row=document.createElement('div');
        row.className='ux-field-row';
        section.insertBefore(row,label);
        row.append(label,control);
      });
    });
    ['corrugated-wrapper','white-split-wrapper','haptprint-wrapper','liquidlam-wrapper','primer-wrapper'].forEach(id => {
      const wrapper=document.getElementById(id);
      if (!wrapper) return;
      wrapper.classList.add('ux-field-row');
    });
    uxNormalizeConditionalRows();
  }

  function uxNormalizeConditionalRows() {
    ['corrugated-wrapper','white-split-wrapper','haptprint-wrapper','liquidlam-wrapper','primer-wrapper'].forEach(id => {
      const wrapper=document.getElementById(id);
      if (!wrapper) return;
      if (wrapper.style.display && wrapper.style.display !== 'none') wrapper.style.display='grid';
    });
  }

  function uxCreateSegmentFor(select) {
    if (!select || select.dataset.uxSegment) return;
    select.dataset.uxSegment='1';
    select.classList.add('ux-source-select');
    const seg=document.createElement('div');
    seg.className='ux-segment';
    ['Ja','Nein'].forEach(value => {
      const b=document.createElement('button');
      b.type='button'; b.textContent=value; b.dataset.value=value;
      b.addEventListener('click', () => {
        select.value=value;
        select.dispatchEvent(new Event('input',{bubbles:true}));
        select.dispatchEvent(new Event('change',{bubbles:true}));
        uxRefreshSegments();
      });
      seg.appendChild(b);
    });
    select.insertAdjacentElement('afterend',seg);
  }

  function uxRefreshSegments() {
    ['corrugated','haptprint','liquidlamination'].forEach(name => {
      const sel=document.querySelector('[name="'+name+'"]');
      if (!sel) return;
      uxCreateSegmentFor(sel);
      const seg=sel.nextElementSibling;
      if (!seg?.classList.contains('ux-segment')) return;
      $$('button',seg).forEach(b => b.classList.toggle('active', b.dataset.value===sel.value));
    });
  }

  function uxNormalizeColorLabel(text) {
    return (text||'').trim().toLowerCase().replace(/\s+/g,'').replace(/_/g,'-');
  }
  function uxColorForLabel(text) {
    const n=uxNormalizeColorLabel(text);
    if (n==='braun') return ['#8B4513','#8B4513'];
    if (n==='rot') return ['#ff0000','#ff0000'];
    if (n==='grün'||n==='gruen') return ['#008000','#008000'];
    if (n==='violett') return ['#8a2be2','#8a2be2'];
    if (n==='pantone') return ['#201747','#201747'];
    if (n==='black'||n==='schwarz'||n.startsWith('schwarz/')) return ['#000','#777'];
    if (/^grau-?1$/.test(n)) return ['#777','#777'];
    if (/^grau-?2$/.test(n)) return ['#555','#555'];
    if (/^grau-?3$/.test(n)) return ['#333','#555'];
    return null;
  }
  function uxEnsureRatingDots() {
    $$('.rating-caption').forEach(caption => {
      const c=uxColorForLabel(caption.textContent);
      if (!c) return;
      let dot=$('.rating-color-dot',caption);
      if (!dot) {
        dot=document.createElement('span');
        dot.className='rating-color-dot ux-rating-dot';
        caption.prepend(dot);
      } else dot.classList.add('ux-rating-dot');
      Object.assign(dot.style,{display:'inline-block',borderRadius:'50%',backgroundColor:c[0],border:'1px solid '+c[1],boxSizing:'border-box'});
      caption.style.display='inline-flex'; caption.style.alignItems='center';
    });
  }

  function uxEnhanceNotes(box) {
    $$(':scope > textarea',box).forEach(textarea => {
      if (textarea.dataset.uxNote) return;
      textarea.dataset.uxNote='1';
      const prev=textarea.previousElementSibling;
      const wrap=document.createElement('div');
      wrap.className='ux-note-wrap';
      const btn=document.createElement('button');
      btn.type='button'; btn.className='ux-note-toggle';
      if (prev?.tagName==='LABEL') prev.classList.add('ux-note-original-label');
      textarea.parentNode.insertBefore(wrap, textarea);
      wrap.append(btn,textarea);
      const update=() => {
        const has=!!textarea.value.trim();
        btn.textContent=(wrap.classList.contains('open')?'− ':'＋ ')+'Anmerkungen'+(has?' ✓':'');
      };
      btn.addEventListener('click',e => {e.stopPropagation(); wrap.classList.toggle('open'); update(); if(wrap.classList.contains('open')) textarea.focus();});
      textarea.addEventListener('input',update);
      if (textarea.value.trim()) wrap.classList.add('open');
      update();
    });
  }

  function uxBlockProgress(box) {
    const groups=$$('.rating-group[data-rating-name]',box);
    const signoffs=$$('.signoff-input',box);
    const numbers=$$('.number-grid input',box);
    let total=groups.length+signoffs.length+numbers.length;
    let done=0;
    groups.forEach(g => { if ($$('input[type="checkbox"]',g).some(i=>i.checked)) done++; });
    signoffs.forEach(i => { if(i.checked) done++; });
    numbers.forEach(i => { if(String(i.value).trim()!=='') done++; });
    return {done,total,complete:total>0 && done===total};
  }

  function uxUpdateBlock(box, allowCollapse=false) {
    if (!box) return;
    const p=uxBlockProgress(box);
    let badge=$('.ux-block-progress',box);
    if (!badge) {
      badge=document.createElement('span'); badge.className='ux-block-progress';
      $('.banding-box-header',box)?.appendChild(badge);
    }
    badge.textContent=p.total ? (p.complete?'✓ '+p.done+'/'+p.total+' Prüfpunkte':p.done+'/'+p.total) : '';
    box.classList.toggle('ux-complete',p.complete);
    if (!p.complete) {
      box.classList.remove('ux-complete-collapsed','ux-manual-open');
    } else if (allowCollapse && !box.classList.contains('ux-manual-open')) {
      box.classList.add('ux-complete-collapsed');
    }
  }

  function uxNormalizeRatingRows(box) {
    $$(':scope > .rating-group', box).forEach(group => {
      const label=group.previousElementSibling;
      if (!label || label.tagName!=='LABEL' || label.closest('.rating-row')) return;
      const row=document.createElement('div');
      row.className='rating-row';
      label.classList.add('rating-caption');
      box.insertBefore(row,label);
      row.append(label,group);
    });
  }

  function uxEnhanceBlocks() {
    $$('.banding-box').forEach(box => {
      uxNormalizeRatingRows(box);
      uxEnhanceNotes(box);
      if (!box.dataset.uxEnhanced) {
        box.dataset.uxEnhanced='1';
        const header=$('.banding-box-header',box);
        header?.addEventListener('click',e => {
          if (e.target.closest('button')) return;
          if (!box.classList.contains('ux-complete')) return;
          const collapsed=box.classList.contains('ux-complete-collapsed');
          box.classList.toggle('ux-complete-collapsed',!collapsed);
          box.classList.toggle('ux-manual-open',collapsed);
        });
      }
      uxUpdateBlock(box,false);
    });
    uxEnsureRatingDots();
  }

  function uxRefreshNoteStates() {
    $$('.ux-note-wrap').forEach(wrap => {
      const ta=$('textarea',wrap), btn=$('.ux-note-toggle',wrap);
      if (!ta||!btn) return;
      const has=!!ta.value.trim();
      if (has) wrap.classList.add('open');
      btn.textContent=(wrap.classList.contains('open')?'− ':'＋ ')+'Anmerkungen'+(has?' ✓':'');
    });
  }

  function uxUpdateSectionSummaries() {
    const a=document.getElementById('section-allgemein-toggle');
    if (a) {
      const serial=$('[name="seriennummer"]')?.value.trim();
      const qm=$('[name="qm_pruefer"]')?.value;
      const ink=$('[name="tintentyp"]')?.value;
      const software=$('[name="drucksoftware"]')?.value;
      $('.ux-section-summary',a).textContent=[serial&&('SN '+serial),qm,ink,software].filter(Boolean).join(' · ') || 'Noch keine Angaben';
    }
    const s=document.getElementById('section-spez-toggle');
    if (s) {
      const machine=$('[name="maschinentyp"]')?.value;
      const white=$('[name="white_varnish"]')?.value;
      const special=$('[name="Sonderfarben"]')?.value;
      $('.ux-section-summary',s).textContent=[machine,white,special && special!=='nicht gefüllt'?special:null].filter(Boolean).join(' · ') || 'Noch keine Angaben';
    }
    const b=document.getElementById('section-bild-toggle');
    if (b) {
      const visible=$$('.banding-box').filter(x=>x.style.display!=='none');
      const complete=visible.filter(x=>uxBlockProgress(x).complete).length;
      $('.ux-section-summary',b).textContent=visible.length ? complete+'/'+visible.length+' Blöcke erledigt' : 'Noch keine relevanten Prüfungen';
    }
  }

  function uxCreateTopControls() {
    const h1=$('h1'); if(!h1 || $('.ux-top-actions')) return;
    const bar=document.createElement('div'); bar.className='ux-top-actions';
    const fresh=document.createElement('button'); fresh.type='button'; fresh.textContent='Neue Abnahme'; fresh.className='btn-green';
    const load=document.createElement('button'); load.type='button'; load.textContent='Gespeicherte laden'; load.className='btn-blue';
    const theme=document.createElement('button'); theme.type='button'; theme.className='ux-theme-btn'; theme.setAttribute('aria-label','Theme wechseln');
    const setThemeIcon=()=> theme.textContent=document.body.classList.contains('light-theme')?'☀':'☾';
    fresh.addEventListener('click',()=>{ resetForm(); setTimeout(()=>uxOpenSection('allgemein'),30); });
    load.addEventListener('click',()=>{
      const wrapper=document.getElementById('saved-entries-wrapper'); if(!wrapper) return;
      renderSavedEntriesList();
      wrapper.style.display = wrapper.style.display==='block'?'none':'block';
      if (wrapper.style.display==='block') wrapper.scrollIntoView({behavior:'smooth',block:'nearest'});
    });
    theme.addEventListener('click',()=>{
      document.body.classList.toggle('light-theme');
      localStorage.setItem('theme',document.body.classList.contains('light-theme')?'light':'dark');
      setThemeIcon();
    });
    bar.append(fresh,load,theme); h1.insertAdjacentElement('afterend',bar); setThemeIcon();

    const saveLoad=document.getElementById('save-load-section');
    const wrapper=document.getElementById('saved-entries-wrapper');
    if (wrapper) bar.insertAdjacentElement('afterend',wrapper);
    const save=document.getElementById('save-button');
    if (save) save.textContent='Abnahme speichern';
    if (saveLoad && !$('.ux-autosave-status',saveLoad)) {
      const status=document.createElement('div'); status.className='ux-autosave-status'; status.textContent='✓ Änderungen werden automatisch gesichert';
      saveLoad.insertBefore(status,saveLoad.firstChild);
    }
    if (wrapper && !$('.ux-saved-search',wrapper)) {
      const search=document.createElement('input'); search.type='search'; search.placeholder='Seriennummer suchen …'; search.className='ux-saved-search';
      wrapper.insertBefore(search,wrapper.children[1]||null);
      search.addEventListener('input',()=>{
        const q=search.value.trim().toLowerCase();
        $$('#saved-entries-list > div').forEach(item=> item.style.display=item.textContent.toLowerCase().includes(q)?'':'none');
      });
    }
  }

  function uxCreateAdminToggleAndMoveReset() {
    const bild=document.getElementById('section-bild-content'); if(!bild) return;
    if (!$('.ux-admin-toggle',bild)) {
      const b=document.createElement('button'); b.type='button'; b.className='ux-admin-toggle'; b.textContent='⚙ Verwaltung';
      b.addEventListener('click',()=> bild.classList.toggle('ux-admin-open'));
      bild.insertBefore(b,bild.firstChild);
    }
    const reset=$('button[onclick="resetBildbewertung()"]',bild);
    const list=document.getElementById('bildbewertung-list');
    if (reset && list) { reset.textContent='Bewertungen leeren'; list.insertAdjacentElement('afterend',reset); }
  }

  function uxCreateJumpNav() {
    if ($('.ux-jump-nav')) return;
    const nav=document.createElement('nav'); nav.className='ux-jump-nav'; nav.setAttribute('aria-label','Bereiche');
    [['allgemein','Allgemein'],['spez','Spez.'],['bild','Bewertung']].forEach(([key,label])=>{
      const b=document.createElement('button'); b.type='button'; b.dataset.key=key; b.textContent=label;
      b.addEventListener('click',()=>uxOpenSection(key)); nav.appendChild(b);
    });
    document.body.appendChild(nav);
    let ticking=false;
    const update=()=>{
      ticking=false;
      const h1=$('h1');
      const show=!!h1 && h1.getBoundingClientRect().bottom < 0 && !document.body.classList.contains('ux-field-focus');
      nav.classList.toggle('visible',show);
      const defs=[['allgemein','section-allgemein-toggle'],['spez','section-spez-toggle'],['bild','section-bild-toggle']];
      let active='allgemein', best=-Infinity;
      defs.forEach(([key,id])=>{ const el=document.getElementById(id); if(!el)return; const top=el.getBoundingClientRect().top; if(top<=window.innerHeight*.38 && top>best){best=top;active=key;} });
      $$('button',nav).forEach(b=>b.classList.toggle('active',b.dataset.key===active));
    };
    const request=()=>{if(!ticking){ticking=true;requestAnimationFrame(update);}};
    addEventListener('scroll',request,{passive:true}); addEventListener('resize',request,{passive:true}); request();
    document.addEventListener('focusin',e=>{if(e.target.matches('input,textarea,select')){document.body.classList.add('ux-field-focus');request();}});
    document.addEventListener('focusout',()=>{setTimeout(()=>{document.body.classList.remove('ux-field-focus');request();},120);});
  }

  function uxInitializeStatic() {
    uxDecorateSectionTitles(); uxCompactStaticSections(); uxRefreshSegments(); uxCreateTopControls(); uxCreateAdminToggleAndMoveReset(); uxCreateJumpNav(); uxUpdateSectionSummaries();
  }

  // Wrap existing functions without changing their underlying data model.
  if (typeof setupSectionToggles==='function') {
    const original=setupSectionToggles;
    setupSectionToggles=function(){ original(); uxDecorateSectionTitles(); const c=document.getElementById('section-allgemein-content'),t=document.getElementById('section-allgemein-toggle'); if(c&&t){c.style.display='block';t.classList.remove('collapsed');} uxUpdateSectionSummaries(); };
  }
  if (typeof updateCorrugatedVisibility==='function') {
    const original=updateCorrugatedVisibility;
    updateCorrugatedVisibility=function(){ original(); uxNormalizeConditionalRows(); uxRefreshSegments(); };
  }
  if (typeof updateWhiteSplitVisibility==='function') {
    const original=updateWhiteSplitVisibility;
    updateWhiteSplitVisibility=function(){ original(); uxNormalizeConditionalRows(); uxRefreshSegments(); };
  }
  if (typeof renderRatingGroups==='function') {
    const original=renderRatingGroups;
    renderRatingGroups=function(){ original(); uxEnhanceBlocks(); };
  }
  if (typeof applyRatingCaptionColors==='function') {
    const original=applyRatingCaptionColors;
    applyRatingCaptionColors=function(){ original(); uxEnsureRatingDots(); };
  }
  if (typeof loadEntryByKey==='function') {
    const original=loadEntryByKey;
    loadEntryByKey=function(key){ original(key); setTimeout(()=>{uxRefreshSegments();uxRefreshNoteStates();uxEnhanceBlocks();uxUpdateSectionSummaries();},0); };
  }
  if (typeof resetForm==='function') {
    const original=resetForm;
    resetForm=function(){ original(); setTimeout(()=>{uxRefreshSegments();uxRefreshNoteStates();uxEnhanceBlocks();uxUpdateSectionSummaries();uxOpenSection('allgemein',false);},0); };
  }
  if (typeof resetBildbewertung==='function') {
    const original=resetBildbewertung;
    resetBildbewertung=function(){ original(); $$('.banding-box').forEach(b=>b.classList.remove('ux-complete','ux-complete-collapsed','ux-manual-open')); $$('.ux-note-wrap').forEach(w=>w.classList.remove('open')); uxRefreshNoteStates(); uxEnhanceBlocks(); uxUpdateSectionSummaries(); };
  }

  document.addEventListener('DOMContentLoaded', () => {
    uxInitializeStatic();
    setTimeout(()=>{uxInitializeStatic();uxEnhanceBlocks();uxRefreshSegments();uxRefreshNoteStates();uxUpdateSectionSummaries();},250);
  });

  document.addEventListener('input',e=>{
    uxRefreshSegments(); uxUpdateSectionSummaries();
    const box=e.target.closest?.('.banding-box');
    if (box && e.target.tagName!=='TEXTAREA' && !e.target.closest('.number-grid')) uxUpdateBlock(box,false);
  });
  document.addEventListener('change',e=>{
    // Einige mobile Browser melden eine Select-Änderung primär als change.
    // Deshalb die bestehende Sichtbarkeitslogik hier zusätzlich zuverlässig nachziehen.
    if (typeof updateWhiteSplitVisibility==='function') updateWhiteSplitVisibility();
    if (typeof updateCorrugatedVisibility==='function') updateCorrugatedVisibility();
    if (typeof updateBandingVisibility==='function') updateBandingVisibility();
    uxRefreshSegments(); uxNormalizeConditionalRows(); uxUpdateSectionSummaries();
    const box=e.target.closest?.('.banding-box'); if(box && e.target.tagName!=='TEXTAREA') uxUpdateBlock(box,true);
    setTimeout(()=>{uxEnhanceBlocks();uxUpdateSectionSummaries();},0);
  });
  document.addEventListener('focusout',e=>{
    if (e.target.closest?.('.number-grid')) { const box=e.target.closest('.banding-box'); setTimeout(()=>uxUpdateBlock(box,true),0); }
  });
})();

