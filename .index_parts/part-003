async function loadEvaluationConfiguration() {
  try {
    const saved = await idbGet('settings', 'blocks');

    if (Array.isArray(saved?.value)) {
      // Bereits gespeicherte Bearbeitungskonfigurationen werden 1:1 geladen.
      // Wichtig: migrateCurrentProtocolRules() darf hier nicht bei jedem App-Start
      // erneut laufen, weil diese Routine bewusst Protokollregeln erzwingt und
      // dadurch manuelle Änderungen im Bearbeitungsmodus wieder überschreiben kann.
      IMAGE_EVALUATION_BLOCKS = cloneEvaluationData(saved.value);
      normalizeProtocolFieldIds(IMAGE_EVALUATION_BLOCKS);
    } else {
      IMAGE_EVALUATION_BLOCKS = cloneEvaluationData(DEFAULT_IMAGE_EVALUATION_BLOCKS);
      normalizeProtocolFieldIds(IMAGE_EVALUATION_BLOCKS);
      IMAGE_EVALUATION_BLOCKS = migrateCurrentProtocolRules(IMAGE_EVALUATION_BLOCKS);
      // Die initial erzeugte Konfiguration einmalig persistieren, damit sie bei
      // späteren Starts nicht erneut durch die Migrationslogik verändert wird.
      await saveEvaluationConfiguration();
    }
  } catch (error) {
    console.error('Bearbeitungskonfiguration konnte nicht geladen werden:', error);
    IMAGE_EVALUATION_BLOCKS = cloneEvaluationData(DEFAULT_IMAGE_EVALUATION_BLOCKS);
    normalizeProtocolFieldIds(IMAGE_EVALUATION_BLOCKS);
    IMAGE_EVALUATION_BLOCKS = migrateCurrentProtocolRules(IMAGE_EVALUATION_BLOCKS);
  }
}

async function saveEvaluationConfiguration() {
  await idbPut('settings', { id: 'blocks', value: cloneEvaluationData(IMAGE_EVALUATION_BLOCKS), updatedAt: new Date().toISOString() });
  await cleanupUnusedCustomImages();
}

async function cleanupUnusedCustomImages() {
  let records = [];
  try { records = await idbGetAll('images'); } catch (_) { return; }
  const used = new Set(IMAGE_EVALUATION_BLOCKS.map(block => block.image).filter(Boolean));
  for (const record of records) {
    if (!used.has(record.id)) {
      await idbDelete('images', record.id);
      const url = customImageUrlCache.get(record.id);
      if (url) URL.revokeObjectURL(url);
      customImageUrlCache.delete(record.id);
    }
  }
}

async function getReferenceImageSource(imageId) {
  if (!imageId) return '';
  if (REFERENCE_IMAGES[imageId]) return REFERENCE_IMAGES[imageId];
  if (customImageUrlCache.has(imageId)) return customImageUrlCache.get(imageId);
  try {
    const record = await idbGet('images', imageId);
    if (!record?.blob) return '';
    const url = URL.createObjectURL(record.blob);
    customImageUrlCache.set(imageId, url);
    return url;
  } catch (error) {
    console.error('Referenzbild konnte nicht geladen werden:', error);
    return '';
  }
}

function generateId(prefix) {
  const raw = (window.crypto?.randomUUID ? crypto.randomUUID() : (Date.now().toString(36) + Math.random().toString(36).slice(2)));
  return prefix + '-' + raw.replace(/[^a-zA-Z0-9]/g, '').slice(0, 16);
}

function technicalName(blockId, type) {
  return 'eval_' + String(blockId).replace(/[^a-zA-Z0-9_]/g, '_') + '_' + type + '_' + generateId('f').split('-').pop();
}

function createNewField(type, blockId) {
  if (type === 'rating') return { type:'rating', layout:'standard', label:'Bewertung', name:technicalName(blockId, 'rating') };
  if (type === 'textarea') return { type:'textarea', label:'Anmerkungen:', name:technicalName(blockId, 'text') };
  if (type === 'signoff') return { type:'signoff', layout:'row', label:'i.O.', name:technicalName(blockId, 'signoff'), value:'ok', id:generateId('signoff') };
  if (type === 'numberGrid') return { type:'numberGrid', fields:[createNewNumberField(blockId)] };
  return null;
}

function createNewNumberField(blockId) {
  const name = technicalName(blockId, 'number');
  return { label:'Wert', name, id:name, type:'number', step:'0.01', inputmode:'decimal' };
}

function regenerateBlockFieldIds(block) {
  (block.fields || []).forEach(field => {
    if (field.type === 'numberGrid') {
      (field.fields || []).forEach(item => {
        item.name = technicalName(block.id, 'number');
        item.id = item.name;
      });
      return;
    }
    field.name = technicalName(block.id, field.type || 'field');
    if (field.type === 'signoff') field.id = generateId('signoff');
    else if (field.id) delete field.id;
  });
}

function captureEvaluationValues() {
  const list = document.getElementById('bildbewertung-list');
  const data = {};
  if (!list) return data;
  list.querySelectorAll('input, textarea, select').forEach(el => {
    if (!el.name) return;
    if (el.type === 'checkbox' || el.type === 'radio') {
      if (!data[el.name]) data[el.name] = [];
      if (el.checked) data[el.name].push(el.value);
    } else {
      data[el.name] = el.value;
    }
  });
  return data;
}

function restoreEvaluationValues(data) {
  Object.entries(data || {}).forEach(([name, value]) => {
    if (Array.isArray(value)) {
      value.forEach(v => {
        const el = document.querySelector(`#bildbewertung-list input[name="${CSS.escape(name)}"][value="${CSS.escape(String(v))}"]`);
        if (el) el.checked = true;
      });
    } else {
      const el = document.querySelector(`#bildbewertung-list [name="${CSS.escape(name)}"]`);
      if (el) el.value = value;
    }
  });
}

function rerenderEvaluationBlocksPreservingValues() {
  const state = captureEvaluationValues();
  renderEvaluationBlocks();
  renderRatingGroups();
  applyRatingCaptionColors();
  restoreEvaluationValues(state);
  updateBandingVisibility();
