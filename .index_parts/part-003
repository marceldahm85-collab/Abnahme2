function cloneEvaluationData(value) {
  return JSON.parse(JSON.stringify(value));
}

function openEvaluationDb() {
  if (evaluationDbPromise) return evaluationDbPromise;
  evaluationDbPromise = new Promise((resolve, reject) => {
    if (!window.indexedDB) {
      reject(new Error('IndexedDB wird von diesem Browser nicht unterstützt.'));
      return;
    }
    const request = indexedDB.open(EVALUATION_DB_NAME, EVALUATION_DB_VERSION);
    request.onupgradeneeded = () => {
      const db = request.result;
      if (!db.objectStoreNames.contains('settings')) db.createObjectStore('settings', { keyPath: 'id' });
      if (!db.objectStoreNames.contains('images')) db.createObjectStore('images', { keyPath: 'id' });
    };
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error || new Error('IndexedDB konnte nicht geöffnet werden.'));
  });
  return evaluationDbPromise;
}

async function idbRequest(storeName, mode, callback) {
  const db = await openEvaluationDb();
  return new Promise((resolve, reject) => {
    const tx = db.transaction(storeName, mode);
    const store = tx.objectStore(storeName);
    let request;
    try { request = callback(store); }
    catch (error) { reject(error); return; }
    if (request) {
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    } else {
      tx.oncomplete = () => resolve();
    }
    tx.onerror = () => reject(tx.error);
  });
}

const idbGet = (store, id) => idbRequest(store, 'readonly', s => s.get(id));
const idbGetAll = store => idbRequest(store, 'readonly', s => s.getAll());
const idbPut = (store, value) => idbRequest(store, 'readwrite', s => s.put(value));
const idbDelete = (store, id) => idbRequest(store, 'readwrite', s => s.delete(id));
const idbClear = store => idbRequest(store, 'readwrite', s => s.clear());

function normalizeProtocolFieldIds(blocks) {
  if (!Array.isArray(blocks)) return blocks;
  const testpattern = blocks.find(block => block && block.id === 'block-001');
  if (testpattern && Array.isArray(testpattern.fields)) {
    const signoff = testpattern.fields.find(field => field && field.type === 'signoff');
    if (signoff) {
      signoff.name = 'signoff_testpattern';
      signoff.id = 'signoff-testpattern';
    }
  }
  return blocks;
}

