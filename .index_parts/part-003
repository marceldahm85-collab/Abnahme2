            : "dark";

        localStorage.setItem("theme", currentTheme);
    });
});

function resetBildbewertung() {
    const bildBereich = document.getElementById("section-bild-content");

    if (!bildBereich) return;

    const felder = bildBereich.querySelectorAll("input, textarea, select");

    felder.forEach(function (feld) {
        if (feld.type === "radio" || feld.type === "checkbox") {
            feld.checked = false;
        } else if (feld.tagName === "SELECT") {
            feld.selectedIndex = 0;
        } else {
            feld.value = "";
        }
    });
}

