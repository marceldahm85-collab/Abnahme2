<!DOCTYPE html>
<html lang="de">
<head>

<link rel="manifest" href="manifest.json">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abnahmeprotokoll</title>

    <style>
        :root {
            --bg: #121212;
            --card: #1e1e1e;
            --border: #333333;
            --text: #ffffff;
            --muted: #aaaaaa;
            --radius: 12px;
            --shadow: 0 4px 20px rgba(0,0,0,0.5);
            --rating-1: #22c55e;
            --rating-2: #a3e635;
            --rating-3: #facc15;
            --rating-4: #f97316;
            --rating-5: #ef4444;
            --calendar-icon-filter: invert(1);
        }

        body.light-theme {
            --bg:
                radial-gradient(ellipse at 15% 20%, rgba(0, 255, 255, 0.65) 0%, transparent 45%),
                radial-gradient(ellipse at 85% 25%, rgba(255, 0, 255, 0.55) 0%, transparent 45%),
                radial-gradient(ellipse at 50% 80%, rgba(255, 255, 0, 0.55) 0%, transparent 45%),
                radial-gradient(ellipse at 80% 90%, rgba(0, 0, 0, 0.55) 0%, transparent 40%),
                linear-gradient(135deg, #f8fafc 0%, #e5e7eb 100%);

            --card: rgba(255, 255, 255, 0.6);
            --border: #d4d4d8;
            --text: #111111;
            --muted: #666666;
            --shadow: 0 4px 20px rgba(0,0,0,0.12);
            --calendar-icon-filter: invert(0);

            background-size: 140% 140%;
            background-attachment: fixed;
            animation: cmykWave 8s ease infinite;
        }

@keyframes cmykWave {
    0% {
        background-position: 0% 50%;
    }
    50% {
        background-position: 100% 50%;
    }
    100% {
        background-position: 0% 50%;
    }
}

        body {
            margin: 0;
            background: var(--bg);
            background-attachment: fixed;
            min-height: 100vh;
            font-family: "Inter", sans-serif;
            color: var(--text);
            padding: 40px 16px;
        }

        .container { max-width: 900px; margin: 0 auto; }

        .card {
            background: var(--card);
            padding: 32px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
        }

        h1 { margin-top: 0; font-size: 28px; font-weight: 700; text-align: center; }

        label { display: block; margin-bottom: 6px; }

        .section-title {
            margin-top: 32px;
            font-weight: 600;
            font-size: 24px;
            margin-bottom: 12px;
            cursor: pointer;              /* klickbar */
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-title::after {
            content: '▼';                 /* Pfeil */
            font-size: 16px;
            color: var(--muted);
            transition: transform 0.2s ease;
        }

        .section-title.collapsed::after {
            transform: rotate(-90deg);
        }

        input, textarea, select, button {
            padding: 12px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            font-size: 14px;
            margin-bottom: 16px;
            background: var(--card);
            color: var(--text);
            box-sizing: border-box;
            width: 100%;
        }

        /* Kalender-Icon im Date-Input weiß einfärben */
        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: var(--calendar-icon-filter);
            opacity: 0.9;
            cursor: pointer;
        }

        input[type="date"]::-webkit-datetime-edit {
            color: var(--text);
        }

        input[type="date"]::-moz-focus-inner {
            border: 0;
        }

        textarea { resize: none; height: 42px; }

        button { background: #333; cursor: pointer; }
        button:hover { background: #555; }

        .btn-green,
        .btn-blue,
        .btn-red {
            color: #ffffff;
        }

        .btn-green {
        background: #16a34a; /* Grün */
        }
        .btn-green:hover {
        background: #15803d;
        }

        .btn-blue {
        background: #2563eb; /* Blau */
        }
        .btn-blue:hover {
        background: #1d4ed8;
        }

        .btn-red {
        background: #dc2626; /* Rot */
        }
        .btn-red:hover {
        background: #b91c1c;
        }

        .rating-group { display: flex; gap: 12px; margin-bottom: 16px; }
        .rating-group input[type="checkbox"] { display: none; }

        .rating-group label {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 2px solid var(--border);
            cursor: pointer;
            transition: all 0.25s ease;
            font-weight: 600;
            color: var(--muted);
        }

        .rating-group input:checked + label {
            background: var(--rating-color);
            color: #000;
            border-color: var(--rating-color);
        }

        .banding-box {
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 20px;
            margin-bottom: 24px;
        }

        .signoff-row {
           display: flex;
           align-items: center;
           justify-content: space-between;
           margin-bottom: 8px;
       }

       .signoff-label {
           font-size: 14px;
       }

       .signoff-check {
           width: 22px;
           height: 22px;
           border-radius: 6px;
           border: 2px solid var(--border);
           display: inline-flex;
           align-items: center;
           justify-content: center;
           cursor: pointer;
           background: var(--card);
           transition: background 0.2s ease, border-color 0.2s ease;
       }

       /* echtes Checkbox-Element ausblenden */
       .signoff-input {
           display: none;
       }

       /* Haken-Stil bei aktivierter Checkbox */
       .signoff-input:checked + .signoff-check {
           background: #22c55e;         /* grün */
           border-color: #22c55e;
       }

       .signoff-input:checked + .signoff-check::before {
           content: '✔';
           font-size: 14px;
           color: #000;
       }

.header-image {
    display: block;
    margin: 0 auto 16px;   /* zentriert (auto links/rechts), 16px Abstand nach unten */
    max-width: 220px;      /* maximale Breite, damit es nicht zu groß wird */
    width: 100%;           /* füllt bis max-width den verfügbaren Platz */
    height: auto;          /* Höhe proportional zur Breite */
    object-fit: contain;   /* falls du eine feste Höhe setzen würdest */
    border-radius: 8px;    /* optional, passt zum Card-Stil */
    cursor: pointer;
    transition: transform 0.15s ease, opacity 0.15s ease;
}

.header-image:hover {
    opacity: 0.85;
}

.header-image:active {
    transform: scale(0.97);
}

.banding-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
}

.banding-box-header .banding-box-title {
    margin-bottom: 0;
}

.banding-box-header .reference-image-btn {
    flex: 0 0 auto;
    margin: 0;
}

.reference-image-btn {
    width: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 10px;
    margin: -4px 0 14px;
    border-radius: 8px;
    font-size: 13px;
    color: var(--muted);
    background: transparent;
}

.reference-image-btn:hover {
    color: var(--text);
    background: rgba(127, 127, 127, 0.15);
}

.reference-image-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0, 0, 0, 0.78);
    box-sizing: border-box;
}

.reference-image-modal.open {
    display: flex;
}

.reference-image-dialog {
    position: relative;
    width: min(1000px, 100%);
    max-height: 92vh;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow);
}

.reference-image-modal-title {
    margin: 0 48px 12px 0;
    font-size: 18px;
    font-weight: 600;
}

.reference-image-modal img {
    display: block;
    width: 100%;
    max-height: calc(92vh - 80px);
    object-fit: contain;
    border-radius: 6px;
    background: #fff;
}

.reference-image-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 38px;
    height: 38px;
    margin: 0;
    padding: 0;
    border-radius: 50%;
    font-size: 22px;
    line-height: 1;
}

body.reference-image-open {
    overflow: hidden;
}

/* Zusätzliche SMP-Layouts */
.rating-row {
    margin-bottom: 18px;
}

.rating-caption {
    display: block;
    margin-bottom: 6px;
    color: var(--text);
    font-size: inherit;
    font-weight: 400;
}

.rating-group input[type="radio"] {
    display: none;
}

.number-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 16px;
    margin-bottom: 16px;
}

.number-grid label {
    margin-bottom: 6px;
}

.number-grid input {
    margin-bottom: 0;
}

@media (max-width: 600px) {
    .number-grid {
        grid-template-columns: 1fr;
    }
}

.banding-box-title { font-size: 20px; font-weight: 600; margin-bottom: 16px; }

.number-grid label {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
}

.number-grid label::before {
  content: "";
  width: 0.85em;
  height: 0.85em;
  border-radius: 50%;
  display: inline-block;
  flex: 0 0 0.85em;
  border: 1px solid transparent;
}

/* Farben */
.number-grid label[for$="_cyan"]::before {
  background: cyan;
}

.number-grid label[for$="_magenta"]::before {
  background: magenta;
}

.number-grid label[for$="_yellow"]::before {
  background: yellow;
  border-color: #ccc;
}

.number-grid label[for$="_black"]::before {
  background: black;
}

.number-grid label[for$="_rot"]::before {
  background: red;
}

.number-grid label[for$="_gruen"]::before {
  background: green;
}

.number-grid label[for$="_blau"]::before {
  background: blue;
}

.number-grid label[for$="_violett"]::before {
  background: violet;
}

.number-grid label[for$="_orange"]::before {
  background: orange;
}

.number-grid label[for$="_weiss"]::before {
  background: white;
  border-color: #999;
}

.rating-row .rating-caption {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
}

.rating-row .rating-caption::before {
  content: "";
  width: 0.85em;
  height: 0.85em;
  min-width: 0.85em;
  border-radius: 50%;
  display: inline-block;
  background: var(--rating-dot-color, transparent);
  border: 1px solid var(--rating-dot-border, transparent);
}

.rating-caption {
  margin-left: -20px;
}



/* ── Bearbeitungsmodus Bildbewertung ─────────────────────────────────── */
.evaluation-editor-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 16px;
}
.evaluation-editor-toolbar button { width: auto; margin: 0; }
.evaluation-editor-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.evaluation-editor-actions[hidden] { display: none; }
body.evaluation-edit-mode .banding-box {
    outline: 1px dashed rgba(37, 99, 235, 0.55);
    outline-offset: 2px;
}
.evaluation-block-actions {
    display: none;
    align-items: center;
    gap: 5px;
    margin-left: auto;
}
body.evaluation-edit-mode .evaluation-block-actions { display: inline-flex; }
.evaluation-block-action {
    width: auto;
    min-width: 34px;
    margin: 0;
    padding: 7px 8px;
    font-size: 12px;
    line-height: 1;
    background: transparent;
}
.banding-box-header { flex-wrap: wrap; }
body.evaluation-edit-mode .banding-box-header .reference-image-btn { margin-left: 0; }

.evaluation-editor-modal {
    position: fixed;
    inset: 0;
    z-index: 10020;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 18px;
    background: rgba(0,0,0,0.78);
    box-sizing: border-box;
}
.evaluation-editor-modal.open { display: flex; }
.evaluation-editor-dialog {
    width: min(940px, 100%);
    max-height: 94vh;
    overflow: auto;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow);
    box-sizing: border-box;
}
.evaluation-editor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
}
.evaluation-editor-header h2 { margin: 0; font-size: 22px; }
.evaluation-editor-close { width: 38px; height: 38px; padding: 0; margin: 0; border-radius: 50%; font-size: 20px; }
.editor-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px 16px; }
.editor-grid > div > input,
.editor-grid > div > select { margin-bottom: 0; }
.editor-subtitle { margin: 22px 0 10px; font-weight: 700; font-size: 17px; }
.editor-hint { color: var(--muted); font-size: 12px; margin-top: 6px; }
.editor-image-preview {
    width: 100%;
    min-height: 90px;
    max-height: 220px;
    object-fit: contain;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(127,127,127,0.08);
    margin-top: 10px;
}
.editor-condition-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
.editor-condition-group {
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 10px;
}
.editor-condition-title { font-weight: 600; margin-bottom: 7px; }
.editor-checks { display: flex; flex-wrap: wrap; gap: 6px 10px; }
.editor-check-item { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; margin: 0; }
.editor-check-item input { width: auto; margin: 0; padding: 0; }
.editor-fields-toolbar { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 10px; }
.editor-fields-toolbar button { width: auto; margin: 0; padding: 8px 10px; }
.editor-field-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 10px;
    background: rgba(127,127,127,0.06);
}
.editor-field-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
.editor-field-type { font-size: 13px; font-weight: 700; }
.editor-field-actions { display: flex; gap: 5px; }
.editor-field-actions button { width: auto; margin: 0; padding: 6px 8px; font-size: 12px; }
.editor-field-card input,
.editor-field-card select { margin-bottom: 8px; }
.editor-number-subfields { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 7px; }
.editor-number-row { display: flex; gap: 6px; align-items: center; }
.editor-number-row input { margin: 0; }
.editor-number-row button { width: auto; margin: 0; padding: 8px; }
.editor-add-number { width: auto; margin: 8px 0 0; }
.editor-footer { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }
.editor-footer button { width: auto; min-width: 120px; margin: 0; }
.editor-status {
    display: none;
    margin: 0 0 14px;
    padding: 9px 11px;
    border-radius: 8px;
    border: 1px solid var(--border);
    font-size: 13px;
}
.editor-status.show { display: block; }
body.evaluation-editor-open { overflow: hidden; }
@media (max-width: 650px) {
    .editor-grid, .editor-condition-list, .editor-number-subfields { grid-template-columns: 1fr; }
    .evaluation-editor-dialog { padding: 14px; }
    .evaluation-block-actions { width: 100%; justify-content: flex-end; }
}

    

/* ── Mobile UX refinement layer ─────────────────────────────────────────── */
:root {
  --ux-input-bg: #292929;
  --ux-input-border: #4b5563;
  --ux-focus: #3b82f6;
  --ux-nav-bg: rgba(30,30,30,.94);
}
body.light-theme {
  --ux-input-bg: rgba(255,255,255,.86);
  --ux-input-border: #c7cbd1;
  --ux-nav-bg: rgba(255,255,255,.94);
}

input, textarea, select {
  background: var(--ux-input-bg);
  border-color: var(--ux-input-border);
}
input:focus, textarea:focus, select:focus {
  outline: 2px solid color-mix(in srgb, var(--ux-focus) 55%, transparent);
  outline-offset: 1px;
  border-color: var(--ux-focus);
}

.ux-top-actions {
  display:grid;
  grid-template-columns: 1fr 1fr 42px;
  gap:8px;
  margin: 0 0 14px;
}
.ux-top-actions button { margin:0; min-height:40px; padding:9px 10px; }
.ux-theme-btn { font-size:18px; padding:0 !important; }
.header-image { cursor:default !important; pointer-events:none; }

.section-title {
  margin-top: 20px;
  margin-bottom: 8px;
  font-size: 20px;
  min-height: 32px;
  gap:8px;
  flex-wrap:wrap;
}
.ux-section-main { display:inline-flex; align-items:center; gap:7px; min-width:0; }
.ux-step-number {
  display:inline-flex; align-items:center; justify-content:center;
  width:25px; height:25px; flex:0 0 25px;
  border:1px solid var(--border); border-radius:50%;
  font-size:13px; font-weight:700; color:var(--muted);
}
.ux-section-summary {
  order:3; flex-basis:100%;
  font-size:12px; font-weight:400; color:var(--muted);
  overflow:hidden; white-space:nowrap; text-overflow:ellipsis;
  padding-right:28px;
}
.section-title:not(.collapsed) .ux-section-summary { display:none; }

#section-allgemein-content,
#section-spez-content { margin-top: 4px; }
.ux-field-row {
  display:grid;
  grid-template-columns: minmax(108px, 39%) minmax(0, 1fr);
  align-items:center;
  gap:10px;
  margin:0 0 8px;
  min-height:38px;
}
.ux-field-row > label {
  margin:0;
  font-size:13px;
  line-height:1.2;
}
.ux-field-row > input,
.ux-field-row > select,
.ux-field-row > textarea {
  width:100%;
  min-width:0;
  height:38px;
  min-height:38px;
  margin:0;
  padding:8px 10px;
  font-size:14px;
  border-radius:9px;
}
.ux-field-row > textarea { resize:none; }
#section-spez-content > .ux-field-row,
#section-spez-content > #corrugated-wrapper,
#section-spez-content > #white-split-wrapper,
#section-spez-content > #haptprint-wrapper,
#section-spez-content > #liquidlam-wrapper { margin-bottom:8px; }

.ux-source-select { display:none !important; }
.ux-segment {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:4px;
  min-width:0;
  padding:3px;
  border:1px solid var(--ux-input-border);
  border-radius:9px;
  background:var(--ux-input-bg);
  box-sizing:border-box;
}
.ux-segment button {
  margin:0;
  min-width:0;
  height:30px;
  padding:4px 7px;
  border-radius:7px;
  background:transparent;
  border:1px solid transparent;
  font-size:13px;
}
.ux-segment button.active {
  background:#2563eb;
  border-color:#3b82f6;
  color:#fff;
}

#section-bild-content .evaluation-editor-toolbar { display:none; }
#section-bild-content.ux-admin-open .evaluation-editor-toolbar { display:flex; }
.ux-admin-toggle {
  width:auto;
  margin:0 0 10px auto;
  padding:7px 10px;
  font-size:13px;
  display:flex;
  align-items:center;
  gap:6px;
}

.banding-box {
  padding:12px;
  margin-bottom:10px;
  border-radius:10px;
}
.banding-box-header {
  gap:7px;
  margin-bottom:9px;
  flex-wrap:nowrap;
  cursor:pointer;
}
.banding-box-title {
  font-size:16px;
  margin:0;
  line-height:1.2;
  min-width:0;
  flex:1 1 auto;
}
.reference-image-btn {
  width:34px !important;
  height:34px;
  flex:0 0 34px !important;
  margin:0 !important;
  padding:0 !important;
  justify-content:center;
  font-size:15px;
}
.reference-image-btn span:last-child { display:none; }
.rating-row {
  display:grid;
  grid-template-columns:minmax(92px,1fr) auto;
  align-items:center;
  gap:8px;
  margin-bottom:8px;
}
.rating-row .rating-caption {
  margin:0;
  min-width:0;
  font-size:13px;
  line-height:1.2;
}
.rating-group {
  gap:5px;
  margin:0;
  justify-content:flex-end;
}
.rating-group label {
  width:32px;
  height:32px;
  flex:0 0 32px;
  font-size:13px;
  border-width:1px;
}
.rating-color-dot.ux-rating-dot {
  width:11px !important;
  height:11px !important;
  min-width:11px !important;
  margin-right:5px !important;
}
.number-grid {
  grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  gap:8px !important;
  margin-bottom:8px;
}
.number-grid label { font-size:12px; margin-bottom:4px; }
.number-grid input { height:36px; min-height:36px; padding:7px 8px; }
.signoff-row { min-height:34px; margin-bottom:5px; }

.ux-note-wrap { margin-top:6px; }
.ux-note-toggle {
  width:auto;
  margin:0;
  padding:6px 0;
  border:0;
  background:transparent;
  color:var(--muted);
  font-size:12px;
  text-align:left;
}
.ux-note-toggle:hover { background:transparent; color:var(--text); }
.ux-note-wrap textarea {
  display:none;
  margin:5px 0 0;
  min-height:60px;
  height:60px;
  background:var(--ux-input-bg);
}
.ux-note-wrap.open textarea { display:block; }
.ux-note-original-label { display:none !important; }

.ux-block-progress {
  font-size:11px;
  color:var(--muted);
  white-space:nowrap;
  margin-left:auto;
}
.banding-box.ux-complete .ux-block-progress { color:#22c55e; }
.banding-box.ux-complete-collapsed > :not(.banding-box-header) { display:none !important; }
.banding-box.ux-complete-collapsed { padding-bottom:10px; }
