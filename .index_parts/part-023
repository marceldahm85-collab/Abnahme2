  async function d4CanvasJpegBytes(canvas) {
    const blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',0.94));
    if(blob) return new Uint8Array(await blob.arrayBuffer());
    const dataUrl=canvas.toDataURL('image/jpeg',0.94); const bin=atob(dataUrl.split(',')[1]); const out=new Uint8Array(bin.length); for(let i=0;i<bin.length;i++)out[i]=bin.charCodeAt(i); return out;
