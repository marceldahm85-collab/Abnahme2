    }
    if(machine==='P5 SMP' && software==='DPInkjet') {
      d4Status('Für P5 SMP ist im aktuellen 1E-Protokoll die PSW-Variante dokumentiert. Bitte Drucksoftware PSW wählen oder das Feld leer lassen.','warn');
      return;
    }
    if((machine==='P5 X - Flatbed' || machine==='P5 X - Hybrid') && software==='DPInkjet') {
      d4Status('Für P5-X ist in der bereitgestellten Rev.-6E-Vorlage die PSW-Variante hinterlegt. Bitte Drucksoftware PSW wählen oder das Feld leer lassen.','warn');
      return;
    }
    if((machine==='P5 / HS' || machine==='P5 350 CORE') && !software) {
      d4Status('Bitte zuerst unter SW-Version die Drucksoftware PSW oder DPInkjet auswählen.','warn');
      return;
    }
    if(!['d4','hs-psw','hs-dpinkjet','smp','p5x'].includes(context.template)) {
      d4Status('Für diesen Maschinentyp ist der PDF-Export noch nicht umgesetzt.','warn');
      return;
    }

    const btn=document.getElementById('protocol-export-button');
    const dlBtn=document.getElementById('protocol-download-button');
    if(btn)btn.disabled=true; if(dlBtn)dlBtn.disabled=true;
    d4Status('Protokoll wird erstellt …');
    try {
      let created;
      if(context.template==='d4') created=await d4CreatePdfBlob();
      else if(context.template==='hs-psw') created=await hsCreatePdfBlob('PSW');
       else if(context.template==='hs-dpinkjet') created=await hsCreatePdfBlob('DPInkjet');
       else if(context.template==='p5x') created=await p5xCreatePdfBlob();
       else created=await smpCreatePdfBlob();

      const {blob,warnings=[]}=created;
      const fileName=protocolPdfFilename();
      protocolLastPdf={blob,fileName,warnings};
      const file=new File([blob],fileName,{type:'application/pdf',lastModified:Date.now()});
      // Für Outlook ausschließlich die Datei teilen. Zusätzliche title/text-Daten
      // werden von einigen Outlook-/System-Share-Zielen fehlerhaft verarbeitet.
      const shareData={files:[file]};
      const canShareFiles=typeof navigator.share==='function' &&
        (typeof navigator.canShare!=='function' || navigator.canShare(shareData));

      if(canShareFiles) {
        try {
          await navigator.share(shareData);
          if(warnings.length) d4Status('✓ PDF als Datei zum Teilen übergeben. Hinweis: '+warnings.join(' '),'warn');
          else d4Status('✓ PDF als Datei zum Teilen übergeben.','ok');
        } catch(shareErr) {
          if(shareErr?.name==='AbortError') {
            d4Status('Teilen abgebrochen. Mit dem Download-Button kannst du die PDF speichern.','warn');
          } else {
            console.warn('Datei-Teilen nicht möglich, PDF wird heruntergeladen.',shareErr);
            d4DownloadBlob(blob,fileName);
            d4Status('Datei-Teilen war nicht möglich. Die PDF wurde stattdessen heruntergeladen.','warn');
          }
        }
      } else {
        d4DownloadBlob(blob,fileName);
        if(warnings.length) d4Status('✓ PDF erstellt und heruntergeladen. Hinweis: '+warnings.join(' '),'warn');
        else d4Status('✓ Datei-Teilen wird von diesem Browser nicht unterstützt. PDF wurde heruntergeladen.','ok');
      }
    } catch(err) {
      console.error(err);
      d4Status('PDF konnte nicht erstellt werden: '+(err?.message||err),'error');
    } finally {
      if(btn)btn.disabled=false; if(dlBtn)dlBtn.disabled=false;
    }
  }
  window.generateProtocolPdf=generateProtocolPdf;
  // Kompatibilitätsalias für ältere Aufrufe/Bookmarks innerhalb der App.
  window.generateD4ProtocolPdf=generateProtocolPdf;

  function d4DownloadLastPdf() {
    if(protocolLastPdf?.blob) {
      d4DownloadBlob(protocolLastPdf.blob,protocolLastPdf.fileName);
      d4Status('✓ PDF wurde heruntergeladen.','ok');
      return;
    }
    d4Status('Bitte zuerst das PDF-Protokoll erstellen.','warn');
  }

  function d4SetupExportUi() {
    const saveLoad=document.getElementById('save-load-section'); if(!saveLoad||document.getElementById('protocol-export-actions'))return;
    const wrap=document.createElement('div'); wrap.id='protocol-export-actions'; wrap.className='protocol-export-actions';
    const buttons=document.createElement('div'); buttons.className='protocol-export-buttons';
    const btn=document.createElement('button'); btn.type='button'; btn.id='protocol-export-button'; btn.className='btn-blue'; btn.textContent='PDF erstellen & teilen'; btn.addEventListener('click',generateProtocolPdf);
    const dlBtn=document.createElement('button'); dlBtn.type='button'; dlBtn.id='protocol-download-button'; dlBtn.title='PDF herunterladen'; dlBtn.setAttribute('aria-label','PDF herunterladen'); dlBtn.textContent='↓'; dlBtn.addEventListener('click',d4DownloadLastPdf);
    const status=document.createElement('div'); status.id='protocol-export-status'; status.className='protocol-export-status';
    buttons.append(btn,dlBtn); wrap.append(buttons,status);
    const save=document.getElementById('save-button'); (save?save.insertAdjacentElement('afterend',wrap):saveLoad.appendChild(wrap));
    const update=()=>{
      const m=val('maschinentyp');
      const visible=['P5 D4','P5 D4 - USA','P5 / HS','P5 350 CORE','P5 SMP','P5 X - Flatbed','P5 X - Hybrid'].includes(m);
      wrap.classList.toggle('visible',visible);
      if(!visible) d4Status('');
    };
    update();
    ['input','change'].forEach(evt=>form.addEventListener(evt,e=>{
      if(e.target?.name==='maschinentyp' || e.target?.name==='drucksoftware') update();
    }));
    // Gespeicherte Datensätze und Reset ändern Select-Werte teilweise programmgesteuert.
    if (typeof window.loadEntryByKey === 'function') {
      const originalLoadEntryByKey = window.loadEntryByKey;
      window.loadEntryByKey = function(...args) {
        const result = originalLoadEntryByKey.apply(this,args);
        setTimeout(update,0);
        return result;
      };
    }
    if (typeof window.resetForm === 'function') {
      const originalResetFormForPdf = window.resetForm;
      window.resetForm = function(...args) {
        const result = originalResetFormForPdf.apply(this,args);
        setTimeout(update,0);
        return result;
      };
    }
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',d4SetupExportUi); else d4SetupExportUi();
})();
</script>
<!-- D4 PDF EXPORT END -->
