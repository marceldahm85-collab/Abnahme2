    const parts=[]; const offsets=[0]; let pos=0; const push=p=>{const b=typeof p==='string'?d4Ascii(p):p;parts.push(b);pos+=b.length;};
    const object=(n,arr)=>{offsets[n]=pos;push(`${n} 0 obj\n`);arr.forEach(push);push('\nendobj\n');};
    push('%PDF-1.4\n% Generated by Abnahme-App\n');
    const kids=jpegs.map((_,i)=>`${3+i*3} 0 R`).join(' ');
    object(1,[`<< /Type /Catalog /Pages 2 0 R >>`]); object(2,[`<< /Type /Pages /Kids [${kids}] /Count ${jpegs.length} >>`]);
    jpegs.forEach((jpg,i)=>{
      const pageObj=3+i*3, contentObj=4+i*3, imageObj=5+i*3;
      const content=`q\n${D4_PT_W} 0 0 ${D4_PT_H} 0 0 cm\n/Im0 Do\nQ\n`;
      object(pageObj,[`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${D4_PT_W} ${D4_PT_H}] /Resources << /XObject << /Im0 ${imageObj} 0 R >> >> /Contents ${contentObj} 0 R >>`]);
      object(contentObj,[`<< /Length ${d4Ascii(content).length} >>\nstream\n`,content,'endstream']);
      object(imageObj,[`<< /Type /XObject /Subtype /Image /Width ${D4_IMG_W} /Height ${D4_IMG_H} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${jpg.length} >>\nstream\n`,jpg,'\nendstream']);
    });
    const xref=pos, count=3+jpegs.length*3; push(`xref\n0 ${count}\n0000000000 65535 f \n`);
    for(let i=1;i<count;i++) push(String(offsets[i]).padStart(10,'0')+' 00000 n \n');
